@using PoMode.Shared.Diagnostics

@* One store or service on /diag, as the Po shell's status card (po-tokens.css): its name and a
   po-badge--ok|warn|bad on a line, what it is for under it, then how long asking took and when. *@
<div class="po-diag__card diag-check" data-check="@Check.Name" data-status="@Check.Status">
    <span class="diag-check-name">@Check.Name</span>
    <span class="po-badge @BadgeFor(Check.Status)">@LabelFor(Check.Status)</span>
    <span class="diag-check-text">@Check.Description</span>
    <span class="diag-check-meta">
        @(Check.LatencyMs is { } ms ? $"{ms:0.#} ms · " : "")checked @Check.CheckedAt.ToLocalTime().ToString("HH:mm:ss")
    </span>
</div>

@code {
    [Parameter, EditorRequired] public DiagnosticCheck Check { get; set; } = default!;

    private static string BadgeFor(string status) => status switch
    {
        DiagnosticStatus.Healthy => "po-badge--ok",
        DiagnosticStatus.Degraded => "po-badge--warn",
        _ => "po-badge--bad",
    };

    private static string LabelFor(string status) => status switch
    {
        DiagnosticStatus.Healthy => "Working",
        DiagnosticStatus.Degraded => "Reduced",
        _ => "Not working",
    };
}
