@inject NavigationManager Navigation

@* One "Download" button over a short list of formats, instead of one button per format: a Radzen
   split button that always opens its list (focus, Escape and click-outside are Radzen's). *@
<RadzenSplitButton Text="Download" Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                   AlwaysOpenPopup="true" Click="@Pick" class="download-menu" ButtonAriaLabel="Download this as a file"
                   OpenAriaLabel="Choose a file format">
    @foreach (var item in Items)
    {
        <RadzenSplitButtonItem Text="@item.Label" Value="@item.Href" title="@item.Title" />
    }
</RadzenSplitButton>

@code {
    /// <summary>One format: the label shown, where it downloads from, and a tooltip.</summary>
    public sealed record Item(string Label, string Href, string Title);

    [Parameter, EditorRequired] public required IReadOnlyList<Item> Items { get; set; }

    // The endpoints answer with an attachment, so the browser saves the file and the page stays put.
    private void Pick(RadzenSplitButtonItem? item)
    {
        if (item?.Value is { Length: > 0 } href)
        {
            Navigation.NavigateTo(href, forceLoad: true);
        }
    }
}
