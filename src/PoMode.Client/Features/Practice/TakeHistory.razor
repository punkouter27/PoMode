@using PoMode.Shared.Analysis

@* What the singer's earlier melodies over these chords turned out to be. A mirror, not a grade: the
   server tallies the readings without marking any as the expected one, so there is no best take, no
   run of matches and no percentage here — a take that came out Mixolydian over Dorian chords is a
   finding about the melody, not a miss. The takes themselves are the Songs page's list scoped to them,
   so a take is previewed, compared and deleted the one way a song is. *@
@if (History is { } history)
{
    <RadzenCard class="practice-history" data-take-count="@history.Takes.Count">
        <h2 class="pm-sr-only">Your takes over these chords</h2>
        <p class="history-summary">@history.Summary</p>
    </RadzenCard>
    @if (history.Takes.Count > 0)
    {
        <LibraryList Only="_ids" PageSize="5" Noun="take" OnDeleted="OnDeleted" />
    }
}
else
{
    <RadzenCard class="practice-history">
        <p class="history-summary">No takes to show yet.</p>
    </RadzenCard>
}

@code {
    /// <summary>The takes over the backing Practice has on, or null before the first read lands.</summary>
    [Parameter] public TakeHistoryDto? History { get; set; }

    /// <summary>Raised with a take's job id once the list has deleted it.</summary>
    [Parameter] public EventCallback<string> OnDeleted { get; set; }

    private HashSet<string> _ids = [];
    private TakeHistoryDto? _shown;

    /// <summary>A new history is a new set; the same one keeps its set, so the list is not re-scoped
    /// on every render of the page.</summary>
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_shown, History))
        {
            _shown = History;
            _ids = [.. History?.Takes.Select(take => take.JobId) ?? []];
        }
    }
}
