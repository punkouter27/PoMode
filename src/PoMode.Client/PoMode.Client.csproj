<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1587;CS1570;CS1571;CS1572;CS1574;CS1584;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS0419</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PoMode.Shared\PoMode.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>
  <ItemGroup>
    <!-- The layout's YYMMDD watermark: the date this build was made. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildStamp</_Parameter1>
      <_Parameter2>$([System.DateTime]::Now.ToString("yyMMdd"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
