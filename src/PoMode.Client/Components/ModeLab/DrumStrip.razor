@using PoMode.Shared.Analysis
@inject AnalysisClient Analysis
@inject IJSRuntime JS
@implements IAsyncDisposable

@* A beat spliced to the lab's tempo and played under the chords and melody on the same clock. A beat
   is added here, where it is used, and kept in the library like every upload, so it can be picked
   again; it is cut in the browser (drum-loop.js, loop-cut.js). The WAV is the drums alone. *@
<div class="studio-drums-panel pm-panel" data-drum-job="@_jobId">
    <div class="drums-row">
        <div class="drums-field drums-pick">
            <span class="pm-label drums-label" id="drums-label">Drums</span>
            @if (_choices.Count > 0)
            {
                <RadzenDropDown TValue="string" Data="@_choices" TextProperty="Label" ValueProperty="JobId"
                                Value="@_jobId" Change="@(value => PickAsync((string?)value))"
                                AllowClear="true" Placeholder="None" Disabled="@(_busy || _adding || _recording)"
                                class="drums-dd" id="drums-select" aria-labelledby="drums-label" />
            }
            else if (!_recording)
            {
                <span class="drums-none">No beat yet. Tap or play one without a click; it is cut to this tempo.</span>
            }
        </div>
        @* A beat is not a song: it is not read for its mode but cut to a tempo, so it is kept rather
           than analysed. A plain file input dressed as a Radzen button, as on the Songs page. *@
        <div class="drums-field drums-add">
            @if (_recording)
            {
                <RadzenButton Text="Stop and use it" Icon="stop" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                              Click="@OnStopRecordingAsync" Disabled="@_stopping" id="drums-record-stop" />
                @* What the microphone hears, so a take that is too quiet shows before it is kept. *@
                <div class="drums-meter" @ref="_meter" role="meter" aria-label="Microphone level"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-clip="0">
                    <span class="drums-meter-fill"></span>
                </div>
            }
            else
            {
                <label class="rz-button rz-button-sm rz-variant-filled rz-light rz-shade-default drums-choose"
                       title="A drum beat recorded without a click: it is cut to a loop at this tempo and played with the chords">
                    <RadzenIcon Icon="album" />
                    <span>@(_adding ? "Adding…" : "Choose a beat")</span>
                    <input type="file" accept="audio/*,.mp3,.wav,.m4a" aria-label="Choose a beat" disabled="@_adding"
                           @ref="_beatInput" @onchange="OnBeatChosenAsync" id="drums-choose" />
                </label>
                <RadzenButton Text="Record a beat" Icon="graphic_eq" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                              Click="@OnStartRecordingAsync" Disabled="@_adding" id="drums-record"
                              title="Tap or play a beat into the microphone, no click needed" />
            }
        </div>
        @if (_ready)
        {
            <div class="drums-field">
                <span class="pm-label drums-label" id="drums-bars-label">Bars</span>
                @* 1, 2, 4 or 8: the lengths a phrase comes in, so the loop sits on the chords' own bar
                   lines. Set from what was played (the longest the take fills); a longer one repeats
                   nothing, it leaves the bars after the take silent. *@
                <RadzenSelectBar TValue="int" Value="@_bars" Change="@OnBarsChangedAsync" Size="ButtonSize.Small"
                                 class="drums-bars" id="drums-bars" aria-labelledby="drums-bars-label">
                    <Items>
                        @foreach (var length in LoopBars)
                        {
                            <RadzenSelectBarItem Text="@length.ToString()" Value="@length" />
                        }
                    </Items>
                </RadzenSelectBar>
            </div>
            <RadzenButton Text="Export WAV" Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Click="@ExportAsync" id="drums-export"
                          title="Save the drum loop alone, cut to this tempo" />
        }
    </div>
    @* In the page whether or not a beat is picked, so drum-loop.js always has it to draw on; it takes
       room only once there is a loop to show. *@
    <canvas class="drums-wave @(_ready ? "" : "drums-wave-empty")" @ref="_canvas" aria-hidden="true"></canvas>
    @if (_ready)
    {
        <p class="drums-readout">@Readout</p>
    }
    @if (_error is { } error)
    {
        <p class="drums-error" role="alert">@error</p>
    }
</div>

@code {
    private sealed record DrumChoice(string JobId, string Label);

    /// <summary>The loop lengths offered: loop-cut.js's LOOP_BARS.</summary>
    private static readonly int[] LoopBars = [1, 2, 4, 8];

    /// <summary>Where a beat's tempo is looked for: its pulse is read as the note value that lands
    /// nearest this, so a take comes out between about 85 and 170 BPM.</summary>
    public const double StartBpm = 120;

    /// <summary>The library job to open as the drums on arrival (a beat row in Songs, or one resumed there).</summary>
    [Parameter] public string? InitialJobId { get; set; }

    /// <summary>The lab's tempo. A change recuts the loop to it.</summary>
    [Parameter] public double Bpm { get; set; }

    /// <summary>Raised with the tempo a newly picked beat was played at (to the nearest whole BPM in
    /// the slider's range): the lab moves there, so the hits move as little as they can.</summary>
    [Parameter] public EventCallback<double> OnBeatTempo { get; set; }

    /// <summary>A beat carries no model picks: it is kept, never analysed.</summary>
    private static readonly Dictionary<string, string> NoPins = [];

    private IReadOnlyList<DrumChoice> _choices = [];
    private IJSObjectReference? _module;
    private IJSObjectReference? _uploader;
    private IJSObjectReference? _recorder;
    private ElementReference _beatInput;
    private ElementReference _meter;
    private bool _adding;
    private bool _recording;
    private bool _stopping;

    /// <summary>Set when a recording starts, so the render that draws the meter hands it over once.</summary>
    private bool _meterPending;
    private ElementReference _canvas;
    private string? _jobId;

        /// <summary>Bumped by every pick so a slower earlier load knows it has been superseded.</summary>
        private int _pickGeneration;

        private bool _ready;
    private bool _busy;
    private string? _error;
    private int _bars = 1;
    private int _hits;
    private double _playedBpm;
    private double _cutBpm;

    /// <summary>Set when a beat has just loaded: its canvas has no size until the render that shows
    /// it, so the first cut waits for that render.</summary>
    private bool _cutPending;

    /// <summary>True until the bar count is typed in. While it holds, the count follows what was
    /// played, which matters when a large tempo change reads the same take in double time.</summary>
    private bool _barsAuto = true;

    private string Readout
        => $"{_hits} {(_hits == 1 ? "hit" : "hits")}, played at about {_playedBpm:0} BPM. "
            + $"Each now starts on its sixteenth at {_cutBpm:0.#} BPM: {_bars} {(_bars == 1 ? "bar" : "bars")}. "
            + "It plays with the chords and melody.";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // File names repeat (every microphone take is "recording.wav"), so the time tells them apart.
            // Beats first: they are what the strip is for; any other upload can still be picked.
            _choices = [.. (await Analysis.GetLibraryAsync() ?? [])
                .Where(entry => entry.Origin?.Kind != TakeOrigin.Demo && entry.Stage == JobStage.Complete)
                .OrderByDescending(entry => entry.Origin?.Kind == TakeOrigin.Beat)
                .Select(entry => new DrumChoice(entry.JobId, ChoiceLabel(entry.FileName, entry.CreatedAt)))];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        {
            // The lab works without drums; the strip just has nothing to offer.
        }
        if (InitialJobId is { Length: > 0 } beat && _choices.Any(choice => choice.JobId == beat))
        {
            await PickAsync(beat);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_ready && !_cutPending && _cutBpm != Bpm)
        {
            await CutAsync();
        }
    }

    private static string ChoiceLabel(string? fileName, DateTimeOffset createdAt)
        => $"{fileName} · {createdAt.ToLocalTime():yyyy-MM-dd HH:mm}";

    private Task OnBeatChosenAsync() => AddBeatAsync(_beatInput, name: null);

    /// <summary>
    /// A new beat: over tus like every upload (resumable-upload.js remembers it as a beat if the tab
    /// closes first), kept as a library job, then picked here at once.
    /// </summary>
    private async Task AddBeatAsync(object source, string? name)
    {
        if (_adding)
        {
            return;
        }
        _adding = true;
        _error = null;
        StateHasChanged();
        try
        {
            _uploader ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/upload/resumable-upload.js");
            var uploadId = await _uploader.InvokeAsync<string>("upload", source, name, null, true);
            var (status, error) = await Analysis.StartFromUploadAsync(uploadId, false, NoPins, asBeat: true);
            if (status is null)
            {
                _error = error ?? "The beat could not be kept.";
                return;
            }
            _choices = [new DrumChoice(status.JobId, ChoiceLabel(status.FileName, DateTimeOffset.Now)), .. _choices];
            _adding = false;
            await PickAsync(status.JobId);
        }
        catch (JSException ex)
        {
            // resumable-upload.js rejects with a sentence written to be shown as it is.
            _error = ex.Message.Split('\n')[0];
        }
        catch (HttpRequestException)
        {
            _error = "The server could not be reached. Please try again.";
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task OnStartRecordingAsync()
    {
        _error = null;
        try
        {
            _recorder ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/capture/audio-recorder.js");
            await _recorder.InvokeVoidAsync("startRecording");
            _recording = true;
            _meterPending = true;
        }
        catch (JSException)
        {
            _error = "Microphone access was denied or is unavailable.";
        }
    }

    private async Task OnStopRecordingAsync()
    {
        if (_recorder is null || _stopping)
        {
            return;
        }
        _stopping = true;
        try
        {
            _recording = false;
            await _recorder.InvokeVoidAsync("stopRecording");
            var wavBytes = await _recorder.InvokeAsync<byte[]>("getRecordedWavBytes");
            if (wavBytes.Length <= 44) // header-only WAV: nothing was captured
            {
                _error = "Nothing was recorded.";
                return;
            }
            await AddBeatAsync(wavBytes, "beat.wav");
        }
        finally
        {
            _stopping = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_meterPending && _recording && _recorder is not null)
        {
            _meterPending = false;
            await _recorder.InvokeVoidAsync("watchLevel", _meter);
        }
        if (_cutPending)
        {
            // The render that just finished gave the loop's canvas its size.
            _cutPending = false;
            await CutAsync();
            StateHasChanged();
        }
    }

    private async Task PickAsync(string? jobId)
        {
            // Picking beats quickly is normal — the dropdown is how you audition one. Each pick takes a
            // generation number and a later one abandons the older load, which otherwise finished after
            // the newer one and left the dropdown on beat B showing beat A's waveform and tempo.
            var generation = ++_pickGeneration;
            _jobId = jobId;
            _ready = false;
            _error = null;
            _busy = true;
            try
            {
                // The player's module first: the loop is decoded and played on its AudioContext.
                await JS.InvokeAsync<IJSObjectReference>("import", "./js/player/modal-player.js");
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/player/drum-loop.js");
                if (string.IsNullOrEmpty(jobId))
                {
                    await _module.InvokeVoidAsync("clear");
                    return;
                }
                var status = await _module.InvokeAsync<string>("load", jobId);
                if (generation != _pickGeneration)
                {
                    return;
                }
                if (status != "ok")
                {
                    _error = status switch
                    {
                        "long" => "That recording is over two minutes. A loop wants a few bars.",
                        "empty" => "No hits were found in that recording.",
                        _ => "That recording could not be read.",
                    };
                    return;
            }
                _ready = true;
                _barsAuto = true;
                _cutPending = true;
                var played = await _module.InvokeAsync<double>("playedBpm", StartBpm);
                if (generation != _pickGeneration)
                {
                    return;
                }
                if (played > 0)
                {
                    await OnBeatTempo.InvokeAsync(Math.Clamp(Math.Round(played), BackingControls.MinBpm, BackingControls.MaxBpm));
                }
            }
            catch (JSDisconnectedException)
            {
                // Navigated away mid-decode.
            }
            catch (ObjectDisposedException)
            {
                // The component was disposed between the await and the write below.
            }
            finally
            {
                _busy = false;
                if (generation == _pickGeneration)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }

    private async Task OnBarsChangedAsync(int bars)
    {
        _bars = LoopBars.Contains(bars) ? bars : LoopBars[0];
        _barsAuto = false;
        await CutAsync();
    }

    /// <summary>Splices the picked recording at the lab's tempo. The recording stays decoded in the
    /// module, so a tempo change is a recut, and the module restarts it in step if the loop is playing.</summary>
    private async Task CutAsync()
    {
        if (_module is null || !_ready)
        {
            return;
        }
        _cutBpm = Bpm;
        await _module.InvokeVoidAsync("build", Bpm, _barsAuto ? 0 : _bars, _canvas);
        _bars = await _module.InvokeAsync<int>("bars");
        _hits = await _module.InvokeAsync<int>("hits");
        _playedBpm = await _module.InvokeAsync<double>("sourceBpm");
    }

    /// <summary>Tells the drum loop the transport moved: it starts from the chord loop's own downbeat
    /// when that is playing and falls silent when it is not. Called after every play, pause, stop and seek.</summary>
    public async Task SyncAsync()
    {
        if (_module is not null && _ready)
        {
            await _module.InvokeVoidAsync("sync");
        }
    }

    private async Task ExportAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("exportWav");
        }
    }

    /// <summary>Before the player is disposed: the loop sounds on the player's context.</summary>
    public async ValueTask DisposeAsync()
    {
        // The lab disposes this first, ahead of its player, and the renderer then disposes it again.
        var module = _module;
        _module = null;
        try
        {
            if (module is not null)
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            if (_recorder is not null)
            {
                if (_recording)
                {
                    // Leaving mid-recording would otherwise leave the microphone live.
                    _recording = false;
                    await _recorder.InvokeVoidAsync("stopRecording");
                }
                await _recorder.DisposeAsync();
                _recorder = null;
            }
            if (_uploader is not null)
            {
                await _uploader.DisposeAsync();
                _uploader = null;
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
