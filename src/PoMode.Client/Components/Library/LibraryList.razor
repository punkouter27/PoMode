@using PoMode.Shared.Analysis
@inject AnalysisClient Analysis
@inject BrowserPrefs Prefs
@inject IJSRuntime JS
@inject DialogService Dialogs
@inject NotificationService Notifications
@implements IAsyncDisposable

@* The songs already here, under the ways to add one. This was a page of its own beside Analyze; both
   were about getting audio in and finding it again, so they are one page (Home) and this is its list.
   An empty library draws nothing: the intake card above is already the invitation to add a song. *@
@if (_entries is { Count: 0 })
{
    return;
}

<RadzenCard class="library-card">
    <h2 class="pm-sr-only">Your songs</h2>
    @if (_entries is null)
    {
        <div class="library-skeletons" aria-hidden="true">
            <div class="pm-skeleton"></div>
            <div class="pm-skeleton"></div>
            <div class="pm-skeleton"></div>
        </div>
    }
        else if (_loadError is not null)
    {
            @* A read that failed, not a library that is empty — the difference matters most here. *@
            <p class="library-load-error" role="alert">@_loadError</p>
        }
        else
        {
            @* One tick previews a song under the table, two put them side by side. *@
            var canCompare = _entries.Any(IsAnalysed);
        @* One box for everything a song can be found by: its name, key, mode, tempo or kind. What the
           box understood is shown back as chips, each removable, so "dorian 120" is visibly two filters. *@
        <div class="library-filters" role="search" aria-label="Filter songs">
            <RadzenTextBox Value="@_query.Text" Placeholder="Find songs, e.g. “dorian 120”"
                           aria-label="Find songs by name, key, mode, tempo or kind" class="library-search"
                           @oninput="@(e => SetQueryAsync(e.Value?.ToString() ?? ""))" />
                    <span class="library-count" role="status">@LibraryCount</span>
        </div>
        @if (_query.Chips.Count > 0 || SoundMatches is not null)
        {
            <ul class="library-chips" aria-label="Filters in use">
                @foreach (var chip in _query.Chips)
                {
                    <li>
                        <button type="button" class="library-chip" @onclick="@(() => SetQueryAsync(_query.Without(chip)))"
                                aria-label="@($"Remove filter {chip.Label}")">@chip.Label <span aria-hidden="true">×</span></button>
                    </li>
                }
                @* The words no file name had, heard as a description: the rows are ranked by sound. *@
                @if (SoundMatches is not null)
                {
                    <li>
                        <button type="button" class="library-chip library-chip--sound" data-sound-search="@_query.Description"
                                @onclick="@(() => SetQueryAsync(_query.WithoutDescription()))"
                                aria-label="@($"Remove sound search {_query.Description}")">Sounds like “@_query.Description” <span aria-hidden="true">×</span></button>
                    </li>
                }
            </ul>
        }
        <div class="library-grid" data-library-count="@_entries.Count">
                    @if (Filtered.Count == 0)
                    {
                        @* A filter that matches nothing used to leave the grid's bare "No records to display."
                           and a "0 of 4" counter, with nothing on the page saying the search box is why.
                           The way back is the point, so it is a button here rather than a guess in the box. *@
                        <div class="library-empty" role="status">
                            <RadzenIcon Icon="search" class="library-empty-icon" />
                            <p class="library-empty-text">
                                @if (_soundPending)
                                {
                                    <text>Listening for songs that sound like <strong>@_query.Description</strong>…</text>
                                }
                                else if (_soundEmpty == _query.Description)
                                {
                                    <text>Nothing in your library sounds like <strong>@_query.Description</strong>.</text>
                                }
                                else
                                {
                                    <text>No song matches <strong>@(_query.Text)</strong>.</text>
                                }
                            </p>
                            @* Asked for, never guessed: run unprompted, the sound search answered every
                               typo ("zzzz") with its nearest song, since CLAP scores any words against any
                               audio and gibberish can outscore a real description. *@
                            @if (CanSearchBySound && !_soundPending && _soundEmpty != _query.Description)
                            {
                                <RadzenButton Text="@($"Search by sound: “{_query.Description}”")" Icon="graphic_eq"
                                              ButtonStyle="ButtonStyle.Primary" id="search-by-sound"
                                              Click="@SearchBySoundAsync" />
                            }
                            <RadzenButton Text="Clear the search" Icon="close" ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => SetQueryAsync(string.Empty))" />
                        </div>
                    }
                    else
                    {
                    @* Ranked by sound: the same songs as the table under it, drawn as distance from the
                       words (sound-space.js). Each disc is a link and a label; pointing at a disc or a
                       row lights both, and lets the song be heard from where its disc sits. *@
                    @if (SoundSpace is { } space)
                    {
                        <div class="sound-space" @ref="_soundSpaceEl" data-sound-space="@space.Count"
                             role="group" aria-label="@($"Songs that sound like {_query.Description}, nearest first")">
                            <canvas class="sound-space-canvas" aria-hidden="true"></canvas>
                            @foreach (var (entry, score) in space)
                            {
                                <a class="sound-disc" href="@($"/song/{entry.JobId}")" data-job="@entry.JobId"
                                   data-similarity="@score.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)"
                                   title="@($"{entry.FileName} · {score:0.00}")"
                                   aria-label="@($"{entry.FileName}, sound match {score:0.00}")"></a>
                            }
                        </div>
                    }
                    <RadzenDataGrid Data="@Filtered" TItem="LibraryEntryDto" AllowSorting="true" Density="Density.Compact"
                            AllowPaging="true" PageSize="8" PagerHorizontalAlign="HorizontalAlign.Center"
                            RowRender="@MarkRow">
                <Columns>
                    @* A tick per row rather than a toggle button beside an Open button: two ticked rows
                       are the comparison, and the song name itself is the way in. *@
                    @if (canCompare)
                    {
                        <RadzenDataGridColumn TItem="LibraryEntryDto" Title="" Sortable="false" Width="44px" CssClass="col-compare" HeaderCssClass="col-compare">
                            <Template Context="entry">
                                <RadzenCheckBox TValue="bool" Value="@_compare.Contains(entry.JobId)"
                                                Change="@(_ => ToggleCompareAsync(entry))"
                                                Disabled="@(!IsAnalysed(entry) || (_compare.Count == 2 && !_compare.Contains(entry.JobId)))"
                                                title="Preview this song; tick a second to compare"
                                                aria-label="@($"Preview or compare {entry.FileName}")" />
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn TItem="LibraryEntryDto" Property="FileName" Title="Song" CssClass="col-song">
                        <Template Context="entry">
                            <SongTile Entry="@entry" />
                            @if (entry.Origin?.Kind == TakeOrigin.Beat)
                            {
                                @* A beat has no analysis to open: it was kept for the Mode Lab's drum loop. *@
                                <a class="library-open" href="@($"/modes?beat={entry.JobId}")">@entry.FileName</a>
                            }
                            else if (entry.Stage == JobStage.Complete)
                            {
                                <a class="library-open" href="@($"/song/{entry.JobId}")" data-morph>@entry.FileName</a>
                            }
                            else
                            {
                                @entry.FileName
                            }
                            @* Only the latest run of each song is listed; the badge lists the earlier ones. *@
                            @if (IsLatest(entry) && RunCountOf(entry) is > 1 and var runs)
                            {
                                <button type="button" class="library-runs-badge" @onclick="@(() => ToggleRuns(entry.FileName))"
                                        aria-expanded="@_expanded.Contains(entry.FileName)"
                                        title="@(_expanded.Contains(entry.FileName) ? "Hide the earlier runs" : "Show the earlier runs of this song")">×@runs</button>
                            }
                            else if (!IsLatest(entry))
                            {
                                <span class="library-earlier">earlier run</span>
                            }
                            @* A sung take, a beat or the first-run demo is not an uploaded song, and the row
                               should not read like one; the tooltip carries the server's sentence about it. *@
                            @if (entry.Origin is { Kind: TakeOrigin.Demo } demo)
                            {
                                <span class="library-origin-badge library-origin-badge--demo" title="@demo.Description"
                                      data-origin-kind="@demo.Kind">🎹 demo</span>
                            }
                            else if (entry.Origin is { Kind: TakeOrigin.Beat } beat)
                            {
                                <span class="library-origin-badge" title="@beat.Description"
                                      data-origin-kind="@beat.Kind">🥁 beat</span>
                            }
                            else if (entry.Origin is { } origin)
                            {
                                <span class="library-origin-badge" title="@origin.Description"
                                      data-origin-kind="@origin.Kind">🎤 hum</span>
                            }
                            @if (_offline.Contains(entry.JobId))
                            {
                                <span class="library-offline" title="Kept on this device: opens without a connection">offline</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LibraryEntryDto" Property="CreatedAt" Title="Added" FormatString="{0:yyyy-MM-dd HH:mm}" Width="150px"
                                          CssClass="col-date" HeaderCssClass="col-date" />
                    <RadzenDataGridColumn TItem="LibraryEntryDto" Title="Key" Width="130px" CssClass="col-key" HeaderCssClass="col-key">
                        <Template Context="entry">
                            @if (entry.TonicName is null)
                            {
                                <span>—</span>
                            }
                            else if (string.IsNullOrEmpty(entry.PrimaryMode))
                            {
                                <span><strong>@entry.TonicName</strong> <span class="library-key-missing">— mode unclear</span></span>
                            }
                            else
                            {
                                <span data-morph-key><strong>@entry.TonicName</strong> @ScaleModes.DisplayName(entry.PrimaryMode)</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LibraryEntryDto" Title="Tempo" Width="90px" CssClass="col-tempo" HeaderCssClass="col-tempo">
                        <Template Context="entry">
                            @(entry.TempoBpm is { } bpm ? $"{bpm:0} BPM" : "—")
                        </Template>
                    </RadzenDataGridColumn>
                    @* An all-Complete column says nothing; it only appears when something isn't. *@
                    @if (_entries.Any(e => e.Stage != JobStage.Complete))
                    {
                        <RadzenDataGridColumn TItem="LibraryEntryDto" Property="Stage" Title="Status" Width="110px" />
                    }
                    <RadzenDataGridColumn TItem="LibraryEntryDto" Title="" Sortable="false" Width="52px" CssClass="col-delete" HeaderCssClass="col-delete">
                        <Template Context="entry">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                          Click="@(() => DeleteAsync(entry))" Disabled="@(_deleting == entry.JobId)"
                                          title="Delete this song" aria-label="@($"Delete {entry.FileName}")" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
                            }
                        </div>
                    }
                </RadzenCard>

@if (_compareResults.Count > 0)
{
    <RadzenCard class="compare-panel" data-compare-count="@_compareResults.Count">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Text="@(_compareResults.Count == 2 ? "Side by side" : "Preview")" />
        <div class="compare-cards">
            @foreach (var (entry, result) in _compareResults)
            {
                <div class="compare-card">
                    <div class="compare-title"><a class="library-open" href="@($"/song/{entry.JobId}")" data-morph>@entry.FileName</a></div>
                    @if (entry.Origin is { } sung)
                    {
                        <div class="compare-facts">@sung.Description</div>
                    }
                    <div class="compare-facts">
                        <span data-morph-key>@result.TonicName @(result.PrimaryMode is { } primary ? ScaleModes.DisplayName(primary.ToString()) : "unclear")</span>
                        <span>@($"{result.TempoBpm:0} BPM")</span>
                        <span>@result.Windows.Count windows</span>
                    </div>
                    <div class="mode-timeline" title="Mode over time">
                        @foreach (var window in result.Windows)
                        {
                            var mode = window is { InsufficientEvidence: false, Matches.Count: > 0 }
                                ? window.Matches[0].Mode.ToString() : null;
                            <span class="mode-segment @SegmentClass(mode)"
                                  style="--pm-grow: @SegmentGrow(window)" title="@(mode is null ? "unclear" : ScaleModes.DisplayName(mode))"></span>
                        }
                    </div>
                    <div class="mode-legend">
                        @foreach (var mode in ModesUsed(result))
                        {
                            <span class="legend-item"><span class="mode-segment @SegmentClass(mode)"></span>@ScaleModes.DisplayName(mode)</span>
                        }
                    </div>
                                    </div>
                                }
                                                </div>
        @* With one song previewed, the library answers "what else sounds like this": the other songs
           that spend their time in the same modes, each with the server's reason. *@
        @if (_compareResults.Count == 1 && _similar is { Count: > 0 })
        {
            <div class="similar" data-similar-count="@_similar.Count">
                <h3 class="pm-label">Songs like this</h3>
                <ul class="similar-list">
                    @foreach (var song in _similar)
                    {
                        <li>
                            <a class="library-open" href="@($"/song/{song.JobId}")">@song.FileName</a>
                            <span class="similar-reason">@song.Reason</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </RadzenCard>
}

@code {
    private List<LibraryEntryDto>? _entries;
    private string? _loadError;
    private readonly HashSet<string> _compare = [];
    private string? _deleting;

    /// <summary>Bumped by every comparison change so a slower earlier fetch does not answer for a
    /// selection the user has already moved on from.</summary>
    private int _compareGeneration;
    private readonly List<(LibraryEntryDto Entry, ModalResult Result)> _compareResults = [];
    private List<SimilarSongDto>? _similar;
    private HashSet<string> _offline = [];
    private IJSObjectReference? _offlineJs;

    private LibraryQuery _query = LibraryQuery.Parse("");

    /// <summary>Songs whose earlier runs are listed under the latest one.</summary>
    private readonly HashSet<string> _expanded = [];

    /// <summary>Bumped when <see cref="_expanded"/> changes, so the memoised view knows to rebuild.</summary>
    private int _expandedVersion;

    private void ToggleRuns(string fileName)
    {
        if (!_expanded.Remove(fileName))
        {
            _expanded.Add(fileName);
        }
        _expandedVersion++;
    }

    /// <summary>Entries arrive newest-first, so the first of each file name is its latest run.</summary>
    private bool IsLatest(LibraryEntryDto entry)
        => _entries?.First(e => e.FileName == entry.FileName).JobId == entry.JobId;

    /// <summary>A finished analysis: something to preview, compare or open. A beat is complete but
    /// was only kept, so it has none.</summary>
    private static bool IsAnalysed(LibraryEntryDto entry)
        => entry.Stage == JobStage.Complete && entry.Origin?.Kind != TakeOrigin.Beat;

    private int RunCountOf(LibraryEntryDto entry)
        => _entries?.Count(e => e.FileName == entry.FileName) ?? 1;

    /// <summary>
    /// The grid's view: the latest run of each song (plus opened earlier runs), through the query.
    /// </summary>
    /// <remarks>
    /// Memoised on the inputs that decide it: the markup reads it twice per render and the search
    /// box renders on every keystroke, and <see cref="RadzenDataGrid{T}"/> compares its Data by
    /// reference to decide whether to rebuild, so a fresh list each render forced a full rebuild.
    /// </remarks>
    private List<LibraryEntryDto> Filtered
    {
        get
        {
            var key = (_entries, _expandedVersion, _query, _sound);
            if (_filteredCache is not null && _filteredKey == key)
            {
                return _filteredCache;
            }
            var rows = (_entries ?? [])
                .GroupBy(e => e.FileName)
                .SelectMany(g => _expanded.Contains(g.Key) ? g : g.Take(1))
                .ToList();
            _filteredCache = rows.Where(_query.Matches).ToList();
            // No file name has the words: the songs that sound like them, best first, under the chips.
            if (_filteredCache.Count == 0 && SoundMatches is { } sound)
            {
                var rank = sound.Select((match, i) => (match.JobId, i)).ToDictionary(m => m.JobId, m => m.i);
                _filteredCache = [.. rows.Where(e => rank.ContainsKey(e.JobId) && _query.MatchesFilters(e)).OrderBy(e => rank[e.JobId])];
            }
            _filteredKey = key;
            return _filteredCache;
        }
    }

    /// <summary>
    /// The count, naming both units it is counting. "3 of 4" put a count of songs beside a count of
    /// runs — a second analysis of one file is hidden until its row is expanded — so a library of one
    /// song analysed twice read as if a song were missing. Runs are only mentioned when they differ.
    /// </summary>
    private string LibraryCount
    {
        get
        {
                        var runs = _entries?.Count ?? 0;
                        // Distinct songs, not rows: the grid shows the latest run of each file, so comparing the
                        // filtered row count against the run count would report a difference whenever any song
                        // had been analysed twice — which is the normal case, not a missing song.
                        var songs = Filtered.Select(entry => entry.FileName).Distinct().Count();
                        var allSongs = _entries?.Select(entry => entry.FileName).Distinct().Count() ?? 0;
                        var text = songs == allSongs
                            ? allSongs == 1 ? "1 song" : $"{allSongs} songs"
                            : $"{songs} of {allSongs} songs";
                        return runs > allSongs ? $"{text} · {runs} analyses" : text;
        }
    }

    private List<LibraryEntryDto>? _filteredCache;
    private (List<LibraryEntryDto>? Entries, int Expanded, LibraryQuery Query, (string Words, List<SoundMatchDto> Matches)? Sound) _filteredKey;

    /// <summary>The last answer from the server's search by sound, and the words it answered.</summary>
    private (string Words, List<SoundMatchDto> Matches)? _sound;
    private bool _soundPending;

    /// <summary>Set once the server says it cannot search by sound, so the button stops being offered.</summary>
    private bool _soundUnavailable;

    /// <summary>Words the sound search was asked about and found nothing for.</summary>
    private string? _soundEmpty;

    /// <summary>The sound matches when they answer the words in the box now and name some song.</summary>
    private List<SoundMatchDto>? SoundMatches
        => _sound is { } sound && sound.Words == _query.Description && sound.Matches.Count > 0 ? sound.Matches : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entries = await Analysis.GetLibraryAsync() ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        {
                // A failed read is not an empty library. Setting the list to empty drew the same page as
                // "you have no songs", which read as though the songs had been deleted. The card says what
                // happened instead, and the ways to add a song above it keep working.
                _loadError = "Your library could not be read. The songs are still there.";
                _entries = [];
                return;
            }
            // The search as it was left: "my Dorian songs" should not need typing again each visit.
            if (await Prefs.GetAsync(BrowserPrefs.LibraryFiltersKey, PrefsJsonContext.Default.LibraryFilters) is { } saved)
            {
                _query = LibraryQuery.Parse(saved.Search);
            }
        }

    /// <summary>The ranked songs the sound map draws, best first, while the table is showing a search
    /// by sound rather than a match on names.</summary>
    private List<(LibraryEntryDto Entry, double Score)>? SoundSpace
    {
        get
        {
            if (SoundMatches is not { } sound || Filtered.Count == 0 || Filtered.Any(_query.Matches))
            {
                return null;
            }
            var scores = sound.ToDictionary(m => m.JobId, m => m.Score);
            List<(LibraryEntryDto Entry, double Score)> ranked = [.. Filtered.Where(e => scores.ContainsKey(e.JobId)).Select(e => (e, scores[e.JobId]))];
            return ranked.Count > 0 ? ranked : null;
        }
    }

    private ElementReference _soundSpaceEl;
    private IJSObjectReference? _soundSpaceJs;

    /// <summary>What the map was last drawn for, so it is redrawn only when the answer changes.</summary>
    private string? _soundSpaceShown;

    /// <summary>Each row names its song, so the map can light the row a disc stands for.</summary>
    private static void MarkRow(RowRenderEventArgs<LibraryEntryDto> args)
    {
        if (args.Data is { } row)
        {
            args.Attributes["data-job"] = row.JobId;
        }
    }

    private async Task SyncSoundSpaceAsync()
    {
        var space = SoundSpace;
        var signature = space is null ? null
            : string.Join(';', space.Select(m => $"{m.Entry.JobId}:{m.Score:0.000}"));
        if (signature == _soundSpaceShown)
        {
            return;
        }
        _soundSpaceShown = signature;
        try
        {
            _soundSpaceJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/player/sound-space.js");
            if (space is null)
            {
                await _soundSpaceJs.InvokeVoidAsync("hide");
            }
            else
            {
                await _soundSpaceJs.InvokeVoidAsync("show", _soundSpaceEl, space.Select(m => new
                {
                    jobId = m.Entry.JobId,
                    score = m.Score,
                    tonic = m.Entry.TonicName,
                    mode = m.Entry.PrimaryMode?.ToLowerInvariant() ?? "",
                }).ToArray());
            }
        }
        catch (JSException)
        {
            // The table is the same list; it stands without the map.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncSoundSpaceAsync();
        if (!firstRender)
        {
            return;
        }
        try
        {
            _offlineJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/offline.js");
            _offline = [.. await _offlineJs.InvokeAsync<string[]>("savedIds")];
            await using var transitions = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/transitions.js");
            await transitions.InvokeVoidAsync("install");
            if (_offline.Count > 0)
            {
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // No Cache Storage (a private window): nothing is kept offline, and links stay links.
        }
    }

    private async Task SetQueryAsync(string text)
    {
        _query = LibraryQuery.Parse(text);
        await Prefs.SetAsync(BrowserPrefs.LibraryFiltersKey, new LibraryFilters(text),
            PrefsJsonContext.Default.LibraryFilters);
    }

    /// <summary>Words that matched no file name, long enough to describe a sound, on a server that can listen.</summary>
    private bool CanSearchBySound
        => !_soundUnavailable && _query.Description.Length >= 3 && _entries is not null
           && !_entries.Any(_query.Matches) && _sound?.Words != _query.Description;

    /// <summary>
    /// Asks the server which songs sound like the words no file name had — only when the person
    /// presses "Search by sound". The text tower takes a second or so on a CPU.
    /// </summary>
    private async Task SearchBySoundAsync()
    {
        if (!CanSearchBySound)
        {
            return;
        }
        var words = _query.Description;
        _soundPending = true;
        _soundEmpty = null;
        try
        {
            var matches = await Analysis.SearchBySoundAsync(words);
            _soundUnavailable = matches is null;
            // An empty answer is not kept as a result: a song still being indexed may answer the same
            // words in a moment. It is remembered only to say so instead of offering the button again.
            _sound = matches is { Count: > 0 } ? (words, matches) : null;
            _soundEmpty = matches is { Count: 0 } ? words : null;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _sound = null; // the name search's empty state stands
        }
        _soundPending = false;
    }

    private async Task DeleteAsync(LibraryEntryDto entry)
    {
        var confirmed = await Dialogs.Confirm(
            $"{entry.FileName} and everything read from it are deleted from the server. This cannot be undone.",
            "Delete this song?",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Keep it" });
        if (confirmed != true)
        {
            return;
        }
        _deleting = entry.JobId;
        try
        {
            if (!await Analysis.DeleteSongAsync(entry.JobId))
            {
                Notifications.Notify(NotificationSeverity.Warning, "Not deleted", "The song is busy; try again in a moment.");
                return;
            }
            _entries?.Remove(entry);
            if (_compare.Remove(entry.JobId))
            {
                _compareResults.RemoveAll(c => c.Entry.JobId == entry.JobId);
            }
        }
        catch (HttpRequestException)
        {
            Notifications.Notify(NotificationSeverity.Error, "Not deleted", "The server could not be reached.");
        }
        finally
        {
            _deleting = null;
        }
    }

    private async Task ToggleCompareAsync(LibraryEntryDto entry)
    {
        if (!_compare.Remove(entry.JobId))
        {
            if (_compare.Count == 2)
            {
                return; // two is the comparison; a third selection is ignored until one is untoggled
            }
            _compare.Add(entry.JobId);
        }

            // Ticking and unticking two rows in a few seconds fetches four results. Without a generation
            // the first set's slow answer landed last and described songs the user had already unticked.
            var generation = ++_compareGeneration;
            _compareResults.Clear();
            _similar = null;
            if (_entries is not null)
            {
                foreach (var selected in _entries.Where(e => _compare.Contains(e.JobId)))
                {
                    var result = await Analysis.GetResultAsync(selected.JobId);
                    if (generation != _compareGeneration)
                    {
                        return;
                    }
                    if (result is not null)
                    {
                        _compareResults.Add((selected, result));
                    }
                }
            }
            if (generation != _compareGeneration)
            {
                return;
            }
            if (_compareResults.Count == 1)
            {
                try
                {
                    var similar = await Analysis.GetSimilarAsync(_compareResults[0].Entry.JobId);
                    if (generation == _compareGeneration)
                    {
                        _similar = similar;
                    }
                }
                catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
            {
                // The preview stands without suggestions.
            }
        }
    }

    // Presentation-only mapping (the modes themselves were decided server-side).
    private static string SegmentClass(string? mode)
        => mode is null ? "mode-unclear" : $"mode-{mode.ToLowerInvariant()}";

    private static string SegmentGrow(ModalWindow window)
        => Math.Max(window.EndSec - window.StartSec, 0.1).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static IEnumerable<string> ModesUsed(ModalResult result)
        => result.Windows
            .Where(w => w is { InsufficientEvidence: false, Matches.Count: > 0 })
            .Select(w => w.Matches[0].Mode.ToString())
            .Distinct();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_offlineJs is not null)
            {
                await _offlineJs.DisposeAsync();
            }
            if (_soundSpaceJs is not null)
            {
                await _soundSpaceJs.InvokeVoidAsync("hide");
                await _soundSpaceJs.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
