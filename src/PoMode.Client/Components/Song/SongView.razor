@using PoMode.Shared.Analysis
@inject AnalysisClient Client
@inject DialogService Dialogs
@inject FeatureFlags Flags
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="song-container">
    <RadzenCard class="song-main-card">
        @* The page's heading for assistive tech: which song this is. Sighted readers get it from the
           link or upload that brought them here, and the key badge row stays the visible headline. *@
        <h1 class="pm-sr-only">@($"Analysis of {Status.FileName ?? "this recording"}")</h1>
        @* The one headline: key, mode, confidence, tempo, length. A second "HUD" card under the player
           used to repeat every one of these; now this row is the only place they are stated. *@
        <div class="song-header-row">
            <div class="song-meta-group">
                <div class="song-badge-key">
                    <span class="pm-label song-badge-label">Key & Mode</span>
                    <span class="song-badge-value pm-morph-key" data-morph-target>@PrimaryHeadline</span>
                    @if (Result.PrimaryScaleNoteNames() is { } scale && HasContent)
                    {
                        @* The scale spelled out — server-decided tonic + mode, Shared lookup for names. *@
                        <span class="song-badge-scale">@string.Join(" · ", scale)</span>
                    }
                    @if (Result.PrimaryMode is not null)
                    {
                        <span class="song-badge-sub" data-count-up>@($"{Percents.Of(Result.PrimaryConfidence)} confidence")</span>
                    }
                    @if (HasContent && (Visual.Evidence is not null || _stats is not null))
                    {
                        @* No notes means no mode to argue for, so there is nothing to open. *@
                        <button class="song-why-toggle" type="button" @onclick="ToggleWhy"
                                aria-expanded="@(_whyOpen ? "true" : "false")" aria-haspopup="dialog">
                            Why this mode?
                        </button>
                    }
                </div>

                <div class="song-badge-item">
                    <span class="pm-label song-badge-label">Tempo</span>
                    @if (HasContent)
                    {
                        <span class="song-badge-value" data-count-up>@($"{DisplayBpm:0} BPM")</span>
                    }
                    else
                    {
                        @* The stat reads as a dash rather than a figure the pipeline never measured. *@
                        <span class="song-badge-value song-badge-unknown">—</span>
                        <span class="song-badge-sub">nothing to measure</span>
                    }
                    @if (_liveBpm > 0 && HasContent)
                    {
                        @* Only while a tempo map is driving it, so a steady song does not gain a
                           badge that says nothing. *@
                        <span class="song-badge-sub">live · this bar</span>
                    }
                    else if (Result.TempoEstimated && HasContent)
                    {
                        <span class="song-badge-sub">(estimated)</span>
                    }
                </div>

                <div class="song-badge-item">
                    <span class="pm-label song-badge-label">Melody</span>
                    @if (HasContent)
                    {
                        <span class="song-badge-value">@($"{Visual.DurationSec:0.0}s")</span>
                        <span class="song-badge-sub">@($"{Visual.Notes.Count} notes")</span>
                    }
                    else
                    {
                        @* The span the notes cover, not the file's length, so it is labelled Melody
                           (the player gives the audio's own). On a file with no notes it read "0.0s"
                           beside the player saying "4.0s of audio", a contradiction, not a measurement. *@
                        <span class="song-badge-value">—</span>
                        <span class="song-badge-sub">no notes detected</span>
                    }
                </div>
            </div>

            <div class="song-actions-group">
                @* One button for what is done with this song, rather than three in a row that wrapped
                   to a line of their own on a phone: the download is the press, keeping it offline and
                   starting another track are under the arrow. *@
                <RadzenSplitButton Text="Download MIDI" Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                   Click="@OnSongActionAsync" class="song-actions" data-offline="@(_offline ? "kept" : "no")"
                                   ButtonAriaLabel="Download the melody as a MIDI file" OpenAriaLabel="More for this song">
                    @* Keeps this song's readings and stems on the device (js/shell/offline.js), so it
                       opens on a train. Saying "Kept offline" is the toggle's pressed state. *@
                    <RadzenSplitButtonItem Value="offline" Icon="@(_offline ? "cloud_done" : "cloud_download")" Disabled="@_offlineBusy"
                                           Text="@(_offlineBusy ? "Saving…" : _offline ? $"Kept offline{(_offlineMb is { } mb ? $" · {mb:0.#} MB" : "")} · free it" : "Keep offline")" />
                    @if (OnAnalyzeNew.HasDelegate)
                    {
                        <RadzenSplitButtonItem Value="new" Icon="add" Text="Analyze another track" />
                    }
                </RadzenSplitButton>
                @if (OnRerun.HasDelegate && Status.Origin is null && Flags.Tools.Rerun)
                {
                    <RerunMenu JobId="@Status.JobId" Ran="@RanBy" OnStarted="@(status => OnRerun.InvokeAsync(status))" />
                }
            </div>
        </div>

        @* One row under the headline: where the answer goes next, then where the audio came from and
           how it was tuned. Two rows of their own pushed the player under the fold of a desktop. *@
        @if ((HasContent && Result.PrimaryMode is not null) || Status.Origin is not null || Math.Abs(Result.TuningOffsetCents) >= 0.5)
        {
            <div class="song-subrow">
                @* The answer is a mode, and these are the two pages that do something with one. Without
                   them every page led to a song and a song led nowhere. *@
                @if (HasContent && Result.PrimaryMode is { } mode)
                {
                    <nav class="song-next" aria-label="Take this mode further">
                        <a href="@($"modes?{ModeLink.Query(Result.TonicPitchClass, mode)}")" id="song-to-modes">Explore @PrimaryHeadline in the Mode Lab</a>
                        <a href="@($"practice?{ModeLink.Query(Result.TonicPitchClass, mode)}")" id="song-to-practice">Sing over @PrimaryHeadline chords</a>
                    </nav>
                }
                @* Both sentences are the server's. *@
                @if (Status.Origin is not null || Math.Abs(Result.TuningOffsetCents) >= 0.5)
                {
                    <div class="song-chips">
                        @if (Status.Origin is { } take)
                        {
                            <span class="take-origin" role="note" data-take-origin="@take.Kind">
                                <span aria-hidden="true">@(take.Kind == TakeOrigin.Demo ? "🎹" : "🎤")</span>
                                @take.Description
                            </span>
                        }
                        <TuningNotice Cents="Result.TuningOffsetCents" />
                    </div>
                }
            </div>
        }

        <div class="song-canvas-section">
            @* Played in on arrival. A hum take's colours are then inked on in a sweep: the melody is
               the singer's own, and the colours are the verdict on it. *@
            <AnalysisCanvas Model="Visual" SelectedWindowIndex="SelectedWindowIndex"
                            PlayheadSec="PlayheadSec" OnSeek="OnSeek" HighlightEvidence="_whyOpen"
                            Reveal="true" Ink="@(Status.Origin?.Kind == TakeOrigin.HumTake)"
                            JobId="@Status.JobId" Describe="true"
                            OnReady="@(element => _canvasElement = element)" />
            <div class="song-canvas-foot">
                @if (Flags.Tools.WindowInspector)
                {
                    <WindowInspector Windows="Visual.Windows" SelectedWindowIndex="SelectedWindowIndex" />
                }
                @if (Visual.Sections.Count > 0)
                {
                    <button class="song-why-toggle" type="button" @onclick="ToggleSections"
                            aria-expanded="@(_sectionsOpen ? "true" : "false")" aria-haspopup="dialog">
                        How were the sections found?
                    </button>
                }
            </div>
        </div>

        @* The section is there from the start and the mixer mounts into it once the canvas it drives is
           ready: appearing a moment later, it used to push everything under it down the page. *@
        <div class="song-player-section">
            @if (_canvasElement is { } canvasElement)
            {
                <StemMixer JobId="@Status.JobId" CanvasElement="canvasElement" SeekToSec="PlayheadSec" KeyLabel="@PrimaryHeadline"
                           HasTempoMap="@(Visual.Tempo.Count > 0)" HasSections="@(Visual.Sections.Count > 0)"
                           OnTempoChangedCallback="@(bpm => { _liveBpm = bpm; StateHasChanged(); })" />
            }
        </div>

        @* Last on the card, under the player: the statistics and the conversation about them. Room is
           held while they load, so the player and everything under it do not jump when they land. *@
        @if (_statsLoading)
        {
            <div class="pm-skeleton stats-skeleton" aria-hidden="true"></div>
        }
        <SongStatsPanel JobId="@Status.JobId" Stats="_stats" SummaryFooter="AnalyzedWith" />
        @if (_stats is null && !_statsLoading)
        {
            @* No statistics to sit under: the line stands on its own rather than going missing. *@
            @AnalyzedWith
        }
    </RadzenCard>
</div>

@code {
    [Parameter, EditorRequired] public required JobStatusDto Status { get; set; }
    [Parameter, EditorRequired] public required ModalResult Result { get; set; }
    [Parameter, EditorRequired] public required VisualizationPayload Visual { get; set; }
    [Parameter] public int? SelectedWindowIndex { get; set; }
    [Parameter] public double PlayheadSec { get; set; }
    [Parameter] public EventCallback<double> OnSeek { get; set; }
    [Parameter] public EventCallback OnAnalyzeNew { get; set; }

    /// <summary>A new run of this song was started from "Try another model"; the page follows it.</summary>
    [Parameter] public EventCallback<JobStatusDto> OnRerun { get; set; }

    /// <summary>
    /// Which executor really did each stage, from StageHistory — rewritten after any fallback, so a
    /// local model that failed and handed over to DSP is named here rather than hidden. Shown under the
    /// summary tab; the progress card that used to carry it is gone by the time a result is on screen.
    /// </summary>
    private RenderFragment AnalyzedWith => @<text>
        @if (Executors.Count > 0)
        {
            <p class="song-analyzed-with" data-analyzed-with="@string.Join(",", Executors.Select(e => e.Executor))">
                Analyzed with
                @* Each executor named once: the demo's written score did both the notes and the chords,
                   and listing it twice read as two different things. The attribute keeps every stage. *@
                @foreach (var (tier, executor) in Executors.DistinctBy(e => e.Executor))
                {
                    <span class="song-executor"><TierBadge Tier="tier" /> @ExecutorNames.Display(executor)</span>
                }
                @if (TotalSeconds > 0)
                {
                    <span>@($"in {TotalSeconds:0.0}s")</span>
                }
            </p>
        }
    </text>;

    private IJSObjectReference? _offlineJs;
    private bool _offline;
    private bool _offlineBusy;
    private double? _offlineMb;
    private string? _offlineFor;

    private IReadOnlyDictionary<string, string> RanBy
        => Executors.Zip(Status.Plan).ToDictionary(pair => pair.Second.Stage, pair => pair.First.Executor);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_offlineFor == Status.JobId)
        {
            return;
        }
        _offlineFor = Status.JobId;
        try
        {
            _offlineJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/offline.js");
            var kept = await _offlineJs.InvokeAsync<bool>("isSaved", Status.JobId);
            if (kept != _offline)
            {
                _offline = kept;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // No Cache Storage here: the button still offers, and saving says what went wrong.
        }
    }

    private async Task OnSongActionAsync(RadzenSplitButtonItem? item)
    {
        switch (item?.Value)
        {
            case null:
                // An attachment: the browser downloads it and the page stays where it is.
                Navigation.NavigateTo($"api/analysis/{Status.JobId}/midi", forceLoad: true);
                break;
            case "offline":
                await ToggleOfflineAsync();
                break;
            case "new":
                await OnAnalyzeNew.InvokeAsync();
                break;
        }
    }

    private async Task ToggleOfflineAsync()
    {
        _offlineBusy = true;
        try
        {
            _offlineJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/offline.js");
            if (_offline)
            {
                await _offlineJs.InvokeVoidAsync("forget", Status.JobId);
                (_offline, _offlineMb) = (false, null);
            }
            else
            {
                _offlineMb = await _offlineJs.InvokeAsync<double>("save", Status.JobId);
                _offline = true;
            }
        }
        catch (JSException)
        {
            _offline = false;
        }
        finally
        {
            _offlineBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_offlineJs is not null)
            {
                await _offlineJs.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private ElementReference? _canvasElement;

    /// <summary>The song's statistics, fetched once here and shared by the Why panel and the stats
    /// panel, which both read from them.</summary>
    private SongStats? _stats;
    private string? _statsFor;
    private bool _statsLoading;

    protected override Task OnInitializedAsync() => Flags.LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (_statsFor == Status.JobId)
        {
            return;
        }
        _statsFor = Status.JobId;
        _stats = null;
        _statsLoading = true;
        _whyOpen = false;
        _sectionsOpen = false;
        try
        {
            _stats = await Client.GetStatsAsync(Status.JobId);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        {
            // The canvas and player stand without them; the charts and figures simply do not appear.
        }
        finally
        {
            _statsLoading = false;
        }
    }

    /// <summary>The "Why this mode?" drawer; while it is open the canvas rings the notes it cites.</summary>
    private bool _whyOpen;

    /// <summary>The "How were the sections found?" drawer, which loads the similarity matrix.</summary>
    private bool _sectionsOpen;

    /// <summary>The two explanations open beside the page rather than inside it: a drawer leaves the
    /// canvas where it was, so the rung notes and the playing section stay in view while reading
    /// why, and closing it puts nothing back in a different place.</summary>
    private static SideDialogOptions Drawer => new()
    {
        Position = DialogPosition.Right,
        ShowMask = false,
        CloseDialogOnOverlayClick = true,
        Width = "min(30rem, 100vw)",
        CssClass = "pm-drawer",
    };

    private async Task ToggleWhy()
    {
        if (_whyOpen)
        {
            Dialogs.CloseSide();
            return;
        }
        _whyOpen = true;
        StateHasChanged();
        await Dialogs.OpenSideAsync<ModeWhyPanel>("Why this mode?",
            new Dictionary<string, object?>
            {
                [nameof(ModeWhyPanel.Evidence)] = Visual.Evidence,
                [nameof(ModeWhyPanel.Stats)] = _stats,
                [nameof(ModeWhyPanel.Result)] = Result,
                [nameof(ModeWhyPanel.JobId)] = Status.JobId,
            },
            Drawer);
        _whyOpen = false;
        StateHasChanged();
    }

    private async Task ToggleSections()
    {
        if (_sectionsOpen)
        {
            Dialogs.CloseSide();
            return;
        }
        _sectionsOpen = true;
        StateHasChanged();
        await Dialogs.OpenSideAsync<SectionMap>("How the sections were found",
            new Dictionary<string, object?> { [nameof(SectionMap.JobId)] = Status.JobId, [nameof(SectionMap.PlayheadSource)] = _canvasElement },
            Drawer);
        _sectionsOpen = false;
        StateHasChanged();
    }

    /// <summary>Tempo of the measure the playhead is in, pushed up by the mixer as it changes.</summary>
    private double _liveBpm;

    /// <summary>
    /// The live tempo once playback has reported one, else the whole-song figure. A drifting
    /// performance makes the single average wrong nearly everywhere, so the moment the app knows
    /// better it should say so.
    /// </summary>
    private double DisplayBpm => _liveBpm > 0 ? _liveBpm : Result.TempoBpm;

    /// <summary>
    /// Whether the analysis found anything to report. Silence and near-silence used to be rendered
    /// as a finished result — a key nobody sang, the fallback tempo, and a length of 0.0s beside a
    /// player that knew the file was four seconds long. With no notes there is nothing to key off,
    /// so the badges say so rather than inventing a reading.
    /// </summary>
    private bool HasContent => Visual.Notes.Count > 0;

    private string PrimaryHeadline => !HasContent
        ? "nothing detected"
        : Result.PrimaryMode is null
            ? $"{Result.TonicName} · mode unclear"
            : $"{Result.TonicName} {ScaleModes.DisplayName(Result.PrimaryMode.ToString())}";

    /// <summary>Per planned stage, the executor that last ran it, else the one that was planned.</summary>
    private List<(ExecutionTier Tier, string Executor)> Executors => [.. Status.Plan.Select(stage =>
        Status.StageHistory?.LastOrDefault(record => record.Stage == stage.Stage) is { } ran
            ? (ran.Tier, ran.Executor)
            : (stage.Tier, stage.Executor))];

    private double TotalSeconds => (Status.StageHistory ?? [])
        .Where(record => record.CompletedAt is not null)
        .Sum(record => (record.CompletedAt!.Value - record.StartedAt).TotalSeconds);
}
