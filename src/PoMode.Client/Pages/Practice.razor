@page "/practice"
@page "/practice/{Tab}"
@using PoMode.Shared.Analysis
@using PoMode.Client.Services
@inject AnalysisClient Analysis
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject BrowserPrefs Prefs
@implements IAsyncDisposable

<PageTitle>PoMode · Practice</PageTitle>

<h1 class="pm-sr-only">Practice: sing over the chords</h1>

@* Sing your own melody over someone else's chords, then let the analyzer tell you what mode you
   actually sang.

   There is deliberately no score here. The page issues no target melody, so there is nothing to be
   right or wrong against — and a live "that note is outside the mode" nudge would be worse than
   useless, because it would steer the singer toward the mode the chords were built from before the
   analyzer has had its say. The answer is the analysis, and it arrives after the take, not during it.

   The server side is the Mode Lab's hum path, unchanged: ModalMelodyGenerator voices the backing,
   POST /api/modal-melodies/hum hands the recording to HumTakeSeeder, and the take becomes an ordinary
   restart-safe job whose harmony is known and whose melody is the singer's. This page is a second,
   narrower door onto that — the Mode Lab is a studio, and this is the one exercise. *@

@* Three jobs, three tabs, so the page is one screen rather than a stack of cards: singing over the
   chords (with the backing it is sung over), what earlier takes over them turned out to be, and the
   guitar jam, which has its own key and needs none of the backing row. Client rendering keeps every
   tab mounted, so a take, a plot or a jam survives a look at another tab. Each tab is an address
   too (/practice, /practice/takes, /practice/jam), and moving between them keeps this one page. *@
<div class="practice">
<RadzenTabs RenderMode="TabRenderMode.Client" class="practice-tabs" SelectedIndex="@_tab" SelectedIndexChanged="@OnTabChangedAsync">
    <Tabs>
        <RadzenTabsItem Text="Sing">
            <RadzenCard class="practice-setup">
                <RadzenText class="practice-description"
                            Text="Sing any melody over these chords and the analyzer tells you which mode it turned out to be in. Nothing is scored." />

                @* The same backing row as the Mode Lab's, so the two pages cannot drift on range or wording. *@
                <BackingControls ShowMode="true" Mode="_mode" ModeChanged="OnModePickedAsync"
                                 Tonic="_tonic" TonicChanged="OnTonicPickedAsync"
                                 ProgressionId="@_progressionId" ProgressionIdChanged="OnProgressionPickedAsync"
                                 Progressions="_progressions"
                                 Bpm="_bpm" BpmChanged="OnTempoPickedAsync"
                                 Disabled="@Busy" />
                <ModeNextLinks From="practice" TonicPitchClass="ModeLink.HomeNote(_tonic, _mode)" Mode="_mode"
                               Name="@ModeNames.OnRoot(_tonic, _mode)"
                       Loop="@(SongLoops.Definition(_progressionId) is null ? null : _progressionId)" />

                @* The singer's range, pooled from their own finished takes, and a key that sits the chosen mode
                   inside it. Both sentences and the key are the server's: choosing where a mode's home note
                   should land is a musical decision, so this only applies the key it is handed. *@
                @if (_voice is { } voice)
                {
                    <div class="practice-voice" data-voice-takes-needed="@voice.TakesNeeded">
                        <span class="practice-voice-range">@voice.Summary</span>
                        @if (FitForMode is { } fit)
                        {
                            <RadzenButton Text="@(fit.TonicPitchClass == _tonic ? "Fitted to your voice" : "Fit to my voice")"
                                          Icon="tune" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Disabled="@(Busy || fit.TonicPitchClass == _tonic)"
                                          Click="@FitToVoiceAsync" id="practice-fit" title="@fit.Explanation" />
                        }
                    </div>
                    @* The reason is shown once it applies rather than before: until then it would be a sentence
                       about a key the page is not playing. *@
                    @if (FitForMode is { } applied && applied.TonicPitchClass == _tonic)
                    {
                        <p class="practice-voice-why">@applied.Explanation</p>
                    }
                }
            </RadzenCard>

            @if (_melody is { } melody)
            {
                <RadzenCard class="practice-take" data-practice-state="@_state">
                    <div class="take-head">
                        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Text="@melody.ProgressionName" />
                        @* The chord symbols the server wrote. Naming a chord is a musical statement, so these
                           are read from the generated progression rather than spelled here. *@
                        <div class="chord-row" aria-label="The chords you will sing over">
                            @foreach (var chord in melody.Chords)
                            {
                                <span class="chord-cell">@chord.Symbol</span>
                            }
                        </div>
                    </div>

                    @* Chord tones as bands, your line drawn over them as you sing it. It reports no verdict:
                       the lit segments mean "this note is in the chord underneath", which is a set membership
                       test against notes the server voiced, not an opinion about the mode. *@
                    @* Its room is held from the first render and given up only if the plot declines, so the buttons
                       and the history under it do not jump down when it comes up. *@
                    @* Under the plot, the vibrato measured off the voice as moving dye: a held note leaves a smooth
                       ribbon, a wide vibrato curls it. The readout is the measurement itself, filled in by the
                       module while a take runs. *@
                    <div class="take-plot-wrap @(_plotChecked && !_plotOn ? "hidden" : "")">
                        <canvas class="vibrato-fluid" @ref="_fluidCanvas" aria-hidden="true" data-testid="practice-vibrato-fluid"></canvas>
                        <canvas class="take-plot" @ref="_plotCanvas" aria-hidden="true" data-testid="practice-plot"></canvas>
                        <span class="take-plot-legend">chord tones · your line</span>
                        <span class="vibrato-readout" data-vibrato-readout data-testid="practice-vibrato-readout"></span>
                    </div>

                    <div class="take-actions">
                        @switch (_state)
                        {
                            case TakeState.Idle:
                                <RadzenButton Text="@(_previewing ? "Stop chords" : "Hear the chords")" Icon="volume_up"
                                              ButtonStyle="ButtonStyle.Light" Click="@TogglePreviewAsync"
                                              id="practice-hear" />
                                <RadzenButton Text="Sing over them" Icon="mic" ButtonStyle="ButtonStyle.Primary"
                                              Click="@StartTakeAsync" id="practice-sing" />
                                <RadzenButton Text="New chords" Icon="casino" ButtonStyle="ButtonStyle.Light"
                                              Click="@RerollAsync" id="practice-reroll"
                                              title="A different progression — the key and tempo are left alone" />
                                break;

                            case TakeState.CountingIn:
                                <span class="take-cue counting">Counting you in…</span>
                                break;

                            case TakeState.Recording:
                                <span class="take-dot" aria-hidden="true"></span>
                                <RadzenButton Text="@($"Stop · {_elapsedSec:0.0}s")" ButtonStyle="ButtonStyle.Danger"
                                              Click="@StopTakeAsync" id="practice-stop" />
                                <span class="take-cue recording">Sing anything you like over the chords.</span>
                                break;

                            case TakeState.Captured:
                                <span class="take-length">Take: @($"{_takeSec:0.0}s")</span>
                                <RadzenButton Text="@(_reviewing ? "Stop" : "Hear it back")" Icon="replay"
                                              ButtonStyle="ButtonStyle.Light" Disabled="@_sending"
                                              Click="@ToggleReviewAsync" id="practice-review"
                                              title="Your take against the chords it was sung over" />
                                <RadzenButton Text="@(_sending ? "Analyzing…" : "What mode did I sing? →")"
                                              ButtonStyle="ButtonStyle.Primary" Disabled="@_sending"
                                              Click="@AnalyzeTakeAsync" id="practice-analyze" />
                                <RadzenButton Text="Redo" Icon="delete" ButtonStyle="ButtonStyle.Light"
                                              Disabled="@_sending" Click="@DiscardTakeAsync" id="practice-redo" />
                                break;
                        }
                        @* A beat to sing against, not only chord changes: it plays under the preview, the take and
                           the playback, and can be flipped while any of them runs. *@
                        @* Tinted rather than solid when on, as the mixer's click is, so it does not outshout Sing. *@
                        <RadzenButton Text="Click" Icon="av_timer"
                                      ButtonStyle="@(_click ? ButtonStyle.Primary : ButtonStyle.Light)"
                                      Variant="@(_click ? Variant.Flat : Variant.Filled)"
                                      Shade="@(_click ? Shade.Lighter : Shade.Default)"
                                      aria-pressed="@(_click ? "true" : "false")" Click="@ToggleClickAsync"
                                      id="practice-click" class="take-click"
                                      title="@(_click ? $"Clicking every beat at {_bpm:0} BPM" : "No click, chords only")" />
                    </div>

                    @if (_error is { } error)
                    {
                        <p class="take-error">@error</p>
                    }
                </RadzenCard>
            }
            else if (_loadError is { } loadError)
            {
                <RadzenCard>
                    <p class="take-error">@loadError</p>
                </RadzenCard>
            }
            else
            {
                @* The take card's room, held while the first progression is generated: arriving late, the card
                   used to push everything under it down the page. *@
                <div class="pm-skeleton take-skeleton" aria-hidden="true"></div>
            }
        </RadzenTabsItem>
        <RadzenTabsItem Text="@TakesTabLabel">
            @* Voice type and strongest note from the takes below, worded server-side. Here rather than on
               the Sing tab: it is a reading of those takes, and beside the backing it pushed the take
               itself under the fold of a desktop screen. Present only once the range is: both are read
               from the same pool of notes. *@
            @if (_voice?.Voice is { TypeLabel: not null } singer)
            {
                <RadzenCard class="practice-singer-card">
                    <h2 class="pm-label practice-singer-label">Your voice</h2>
                    <SingerCard Voice="singer" Id="practice-singer" />
                </RadzenCard>
            }
            <TakeHistory History="_history" OnDeleted="OnTakeDeletedAsync" />
        </RadzenTabsItem>
        <RadzenTabsItem Text="Guitar jam">
            @* Practice for the hands rather than the voice: open guitar chords that sound richer than they are to
               play. It takes the page's audio when started, and gives it up when the page plays its own chords. *@
            <ChordJam @ref="_jam" Disabled="@(_state is TakeState.CountingIn or TakeState.Recording)" Started="@StopForJamAsync" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
</div>
