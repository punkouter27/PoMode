@page "/practice"
@page "/practice/{Tab}"
@using PoMode.Shared.Analysis
@using PoMode.Client.Services
@inject AnalysisClient Analysis
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject BrowserPrefs Prefs
@implements IAsyncDisposable

<PageTitle>PoMode · Practice</PageTitle>

<h1 class="pm-sr-only">Practice: sing over the chords</h1>

@* Sing your own melody over someone else's chords, then let the analyzer tell you what mode you
   actually sang.

   There is deliberately no score here. The page issues no target melody, so there is nothing to be
   right or wrong against — and a live "that note is outside the mode" nudge would be worse than
   useless, because it would steer the singer toward the mode the chords were built from before the
   analyzer has had its say. The answer is the analysis, and it arrives after the take, not during it.

   The server side is the Mode Lab's hum path, unchanged: ModalMelodyGenerator voices the backing,
   POST /api/modal-melodies/hum hands the recording to HumTakeSeeder, and the take becomes an ordinary
   restart-safe job whose harmony is known and whose melody is the singer's. This page is a second,
   narrower door onto that — the Mode Lab is a studio, and this is the one exercise. *@

@* Three jobs, three tabs, so the page is one screen rather than a stack of cards: singing over the
   chords (with the backing it is sung over), what earlier takes over them turned out to be, and the
   guitar jam, which has its own key and needs none of the backing row. Client rendering keeps every
   tab mounted, so a take, a plot or a jam survives a look at another tab. Each tab is an address
   too (/practice, /practice/takes, /practice/jam), and moving between them keeps this one page. *@
<div class="practice">
<RadzenTabs RenderMode="TabRenderMode.Client" class="practice-tabs" SelectedIndex="@_tab" SelectedIndexChanged="@OnTabChangedAsync">
    <Tabs>
        <RadzenTabsItem Text="Sing">
            <RadzenCard class="practice-setup">
                <RadzenText class="practice-description"
                            Text="Sing any melody over these chords and the analyzer tells you which mode it turned out to be in. Nothing is scored." />

                @* The same backing row as the Mode Lab's, so the two pages cannot drift on range or wording. *@
                <BackingControls ShowMode="true" Mode="_mode" ModeChanged="OnModePickedAsync"
                                 Tonic="_tonic" TonicChanged="OnTonicPickedAsync"
                                 ProgressionId="@_progressionId" ProgressionIdChanged="OnProgressionPickedAsync"
                                 Progressions="_progressions"
                                 Bpm="_bpm" BpmChanged="OnTempoPickedAsync"
                                 Disabled="@Busy" />
                <ModeNextLinks From="practice" TonicPitchClass="ModeLink.HomeNote(_tonic, _mode)" Mode="_mode"
                               Name="@ModeNames.OnRoot(_tonic, _mode)" />

                @* The singer's range, pooled from their own finished takes, and a key that sits the chosen mode
                   inside it. Both sentences and the key are the server's: choosing where a mode's home note
                   should land is a musical decision, so this only applies the key it is handed. *@
                @if (_voice is { } voice)
                {
                    <div class="practice-voice" data-voice-takes-needed="@voice.TakesNeeded">
                        <span class="practice-voice-range">@voice.Summary</span>
                        @if (FitForMode is { } fit)
                        {
                            <RadzenButton Text="@(fit.TonicPitchClass == _tonic ? "Fitted to your voice" : "Fit to my voice")"
                                          Icon="tune" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Disabled="@(Busy || fit.TonicPitchClass == _tonic)"
                                          Click="@FitToVoiceAsync" id="practice-fit" title="@fit.Explanation" />
                        }
                    </div>
                    @* The reason is shown once it applies rather than before: until then it would be a sentence
                       about a key the page is not playing. *@
                    @if (FitForMode is { } applied && applied.TonicPitchClass == _tonic)
                    {
                        <p class="practice-voice-why">@applied.Explanation</p>
                    }
                }
            </RadzenCard>

            @if (_melody is { } melody)
            {
                <RadzenCard class="practice-take" data-practice-state="@_state">
                    <div class="take-head">
                        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Text="@melody.ProgressionName" />
                        @* The chord symbols the server wrote. Naming a chord is a musical statement, so these
                           are read from the generated progression rather than spelled here. *@
                        <div class="chord-row" aria-label="The chords you will sing over">
                            @foreach (var chord in melody.Chords)
                            {
                                <span class="chord-cell">@chord.Symbol</span>
                            }
                        </div>
                    </div>

                    @* Chord tones as bands, your line drawn over them as you sing it. It reports no verdict:
                       the lit segments mean "this note is in the chord underneath", which is a set membership
                       test against notes the server voiced, not an opinion about the mode. *@
                    @* Its room is held from the first render and given up only if the plot declines, so the buttons
                       and the history under it do not jump down when it comes up. *@
                    @* Under the plot, the vibrato measured off the voice as moving dye: a held note leaves a smooth
                       ribbon, a wide vibrato curls it. The readout is the measurement itself, filled in by the
                       module while a take runs. *@
                    <div class="take-plot-wrap @(_plotChecked && !_plotOn ? "hidden" : "")">
                        <canvas class="vibrato-fluid" @ref="_fluidCanvas" aria-hidden="true" data-testid="practice-vibrato-fluid"></canvas>
                        <canvas class="take-plot" @ref="_plotCanvas" aria-hidden="true" data-testid="practice-plot"></canvas>
                        <span class="take-plot-legend">chord tones · your line</span>
                        <span class="vibrato-readout" data-vibrato-readout data-testid="practice-vibrato-readout"></span>
                    </div>

                    <div class="take-actions">
                        @switch (_state)
                        {
                            case TakeState.Idle:
                                <RadzenButton Text="@(_previewing ? "Stop chords" : "Hear the chords")" Icon="volume_up"
                                              ButtonStyle="ButtonStyle.Light" Click="@TogglePreviewAsync"
                                              id="practice-hear" />
                                <RadzenButton Text="Sing over them" Icon="mic" ButtonStyle="ButtonStyle.Primary"
                                              Click="@StartTakeAsync" id="practice-sing" />
                                <RadzenButton Text="New chords" Icon="casino" ButtonStyle="ButtonStyle.Light"
                                              Click="@RerollAsync" id="practice-reroll"
                                              title="A different progression — the key and tempo are left alone" />
                                break;

                            case TakeState.CountingIn:
                                <span class="take-cue counting">Counting you in…</span>
                                break;

                            case TakeState.Recording:
                                <span class="take-dot" aria-hidden="true"></span>
                                <RadzenButton Text="@($"Stop · {_elapsedSec:0.0}s")" ButtonStyle="ButtonStyle.Danger"
                                              Click="@StopTakeAsync" id="practice-stop" />
                                <span class="take-cue recording">Sing anything you like over the chords.</span>
                                break;

                            case TakeState.Captured:
                                <span class="take-length">Take: @($"{_takeSec:0.0}s")</span>
                                <RadzenButton Text="@(_reviewing ? "Stop" : "Hear it back")" Icon="replay"
                                              ButtonStyle="ButtonStyle.Light" Disabled="@_sending"
                                              Click="@ToggleReviewAsync" id="practice-review"
                                              title="Your take against the chords it was sung over" />
                                <RadzenButton Text="@(_sending ? "Analyzing…" : "What mode did I sing? →")"
                                              ButtonStyle="ButtonStyle.Primary" Disabled="@_sending"
                                              Click="@AnalyzeTakeAsync" id="practice-analyze" />
                                <RadzenButton Text="Redo" Icon="delete" ButtonStyle="ButtonStyle.Light"
                                              Disabled="@_sending" Click="@DiscardTakeAsync" id="practice-redo" />
                                break;
                        }
                        @* A beat to sing against, not only chord changes: it plays under the preview, the take and
                           the playback, and can be flipped while any of them runs. *@
                        @* Tinted rather than solid when on, as the mixer's click is, so it does not outshout Sing. *@
                        <RadzenButton Text="Click" Icon="av_timer"
                                      ButtonStyle="@(_click ? ButtonStyle.Primary : ButtonStyle.Light)"
                                      Variant="@(_click ? Variant.Flat : Variant.Filled)"
                                      Shade="@(_click ? Shade.Lighter : Shade.Default)"
                                      aria-pressed="@(_click ? "true" : "false")" Click="@ToggleClickAsync"
                                      id="practice-click" class="take-click"
                                      title="@(_click ? $"Clicking every beat at {_bpm:0} BPM" : "No click, chords only")" />
                    </div>

                    @if (_error is { } error)
                    {
                        <p class="take-error">@error</p>
                    }
                </RadzenCard>
            }
            else if (_loadError is { } loadError)
            {
                <RadzenCard>
                    <p class="take-error">@loadError</p>
                </RadzenCard>
            }
            else
            {
                @* The take card's room, held while the first progression is generated: arriving late, the card
                   used to push everything under it down the page. *@
                <div class="pm-skeleton take-skeleton" aria-hidden="true"></div>
            }
        </RadzenTabsItem>
        <RadzenTabsItem Text="@TakesTabLabel">
            @* Voice type and strongest note from the takes below, worded server-side. Here rather than on
               the Sing tab: it is a reading of those takes, and beside the backing it pushed the take
               itself under the fold of a desktop screen. Present only once the range is: both are read
               from the same pool of notes. *@
            @if (_voice?.Voice is { TypeLabel: not null } singer)
            {
                <RadzenCard class="practice-singer-card">
                    <h2 class="pm-label practice-singer-label">Your voice</h2>
                    <SingerCard Voice="singer" Id="practice-singer" />
                </RadzenCard>
            }
            <TakeHistory History="_history" OnDeleted="OnTakeDeletedAsync" />
        </RadzenTabsItem>
        <RadzenTabsItem Text="Guitar jam">
            @* Practice for the hands rather than the voice: open guitar chords that sound richer than they are to
               play. It takes the page's audio when started, and gives it up when the page plays its own chords. *@
            <ChordJam @ref="_jam" Disabled="@(_state is TakeState.CountingIn or TakeState.Recording)" Started="@StopForJamAsync" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
</div>

@code {
    /// <summary>A song page's "Sing over it": the mode to open on (<see cref="ModeLink"/>).</summary>
    [SupplyParameterFromQuery] public int? Tonic { get; set; }

    [SupplyParameterFromQuery] public string? Mode { get; set; }

    /// <summary>The tab's address: none for Sing, "takes" or "jam" (<see cref="TabPaths"/>).</summary>
    [Parameter] public string? Tab { get; set; }

    /// <summary>Where a take is in its cycle — one answer to "what is happening" rather than four
    /// booleans that can disagree. Mirrors the Mode Lab's hum states, whose flow this reuses.</summary>
    private enum TakeState { Idle, CountingIn, Recording, Captured }

    /// <summary>Beats of count-in before the loop starts, so the singer has the pulse before bar one.
    /// The recorder trims them back off the front of the take.</summary>
    private const int CountInBeats = 4;

    /// <summary>Ceiling on one take. The loop runs until Stop and the browser holds raw PCM the whole
    /// time, so this bounds memory rather than musical patience.</summary>
    private const double MaxTakeSeconds = 300.0;

    /// <summary>The jam is the third tab.</summary>
    private const int JamTab = 2;

    private IJSObjectReference? _hum;
    private ChordJam? _jam;
    private int _tab;

    /// <summary>The count is on the tab, so how many takes there are is known without opening it.</summary>
    private string TakesTabLabel => _history is { Takes.Count: > 0 } history ? $"Your takes ({history.Takes.Count})" : "Your takes";

    /// <summary>Each tab's address under /practice, in tab order.</summary>
    private static readonly string[] TabPaths = ["practice", "practice/takes", "practice/jam"];

    /// <summary>The tab the address names.</summary>
    private int TabFromAddress => Tab?.ToLowerInvariant() switch
    {
        "takes" => 1,
        "jam" => JamTab,
        _ => 0,
    };

    /// <summary>A link or the back button chose the tab: the same switch a click makes.</summary>
    protected override Task OnParametersSetAsync() => SwitchTabAsync(TabFromAddress);

    /// <summary>A click on a tab: it becomes the address, so it can be linked, bookmarked and gone back from.</summary>
    private async Task OnTabChangedAsync(int index)
    {
        await SwitchTabAsync(index);
        Navigation.NavigateTo(TabPaths[index]);
    }

    /// <summary>A jam left behind on a hidden tab would keep strumming under whatever is shown.</summary>
    private async Task SwitchTabAsync(int index)
    {
        if (_tab == JamTab && index != JamTab && _jam is not null)
        {
            await _jam.StopAsync();
        }
        _tab = index;
    }
    private IJSObjectReference? _player;
    private IJSObjectReference? _plot;
    private DotNetObjectReference<Practice>? _selfRef;
    private ElementReference _plotCanvas;
    private ElementReference _fluidCanvas;
    private bool _plotOn;
    private bool _plotChecked;

    private List<ChordProgressionDefinition> _progressions = [];

    /// <summary>The tempo a page starts on, and the one a remembered tempo that is not a number
    /// falls back to. Named so restoring and the initial value cannot drift apart.</summary>
    private const double DefaultBpm = 92;
    private GeneratedMelodyDto? _melody;

    private ScaleMode _mode = ScaleMode.Dorian;
    private int _tonic = 2;                 // the parent key: Dorian in D, so E Dorian chords
    private string _progressionId = "";
    private double _bpm = DefaultBpm;
    private bool _click = true;

    private TakeState _state = TakeState.Idle;
    private byte[]? _take;
    private ModalMelodyRequest? _backing;
    private double _takeSec;
    private double _elapsedSec;
    private bool _previewing;
    private bool _reviewing;
    private bool _sending;
    private string? _error;
    private string? _loadError;

    private TakeHistoryDto? _history;
    private VocalRangeDto? _voice;

    /// <summary>Which backing <see cref="_history"/> describes. Key and tempo are not part of it —
    /// the server matches takes across both — so moving either leaves the history where it is.</summary>
    private string? _historyFor;

    /// <summary>The fit only while it is for the mode on screen; a mode change refetches it, and until
    /// then the previous mode's key would be the wrong answer.</summary>
    private VoiceFitDto? FitForMode => _voice?.Fit is { } fit && fit.Mode == _mode ? fit : null;

    /// <summary>Settings are locked while the microphone is open: changing the chords underneath a
    /// take in progress would leave the singer's melody filed against chords they never heard.</summary>
    private bool Busy => _state is not TakeState.Idle || _sending;

    /// <summary>One pass of the progression. Taken from the last chord's end rather than from a bar
    /// count, so a progression of any length loops at the point the server actually ended it.</summary>
    private double LoopSeconds
        => _melody is { Chords.Count: > 0 } melody ? melody.Chords[^1].EndSec : 0;

    /// <summary>The server down or restarting is the page's own message, not the app's error panel:
    /// reloading in a moment is all it takes.</summary>
    private const string Unreachable = "The server could not be reached. Reload the page in a moment.";

    private static bool IsUnreachable(Exception ex)
        => ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException;

    protected override async Task OnInitializedAsync()
    {
        // Before the first await: the page first renders while this loads, and the tabs take their
        // starting tab from that render, before OnParametersSetAsync has run.
        _tab = TabFromAddress;
        try
        {
            _progressions = await Analysis.GetModalProgressionsAsync() ?? [];
        }
        catch (Exception ex) when (IsUnreachable(ex))
        {
            _loadError = Unreachable;
            return;
        }
        if (_progressions.Count == 0)
        {
            _loadError = "No chord progressions are available.";
            return;
        }
        // Start on the mode's own signature cadence — a mode is a tonal centre, and rooting the first
        // thing the singer hears on the parent key would put the wrong note under it.
        _progressionId = SignatureIdFor(_mode) ?? _progressions[0].Id;
        await RestoreSettingsAsync();
        // A song page's "Sing over it" outranks the backing left last time: it is what was asked for.
        if (ModeLink.TryRead(Tonic, Mode, out var parent, out var linked))
        {
            (_tonic, _mode) = (parent, linked);
            _progressionId = SignatureIdFor(linked) ?? _progressionId;
        }
        await ReloadAsync();
        await LoadVoiceAsync();
    }

    /// <summary>The backing as it was left: a singer who found their key should come back to it.
        /// Anything unreadable or out of range is ignored and the defaults stand. NaN and infinity pass
        /// <c>Math.Clamp</c> straight through, so they are caught here — a backing of NaN BPM renders as
        /// "NaN BPM" and plays nothing.</summary>
        private async Task RestoreSettingsAsync()
        {
            if (await Prefs.GetAsync(BrowserPrefs.PracticeBackingKey, PrefsJsonContext.Default.PracticeBacking) is
                { TonicPitchClass: >= 0 and < 12 } saved
                && Enum.IsDefined(saved.Mode)
                && _progressions.Any(p => p.Id == saved.ProgressionId))
            {
                (_tonic, _mode, _progressionId, _click) = (saved.TonicPitchClass, saved.Mode, saved.ProgressionId, saved.Click);
                _bpm = double.IsFinite(saved.Bpm)
                    ? Math.Clamp(saved.Bpm, BackingControls.MinBpm, BackingControls.MaxBpm)
                    : DefaultBpm;
            }
        }

    private Task SaveSettingsAsync()
        => Prefs.SetAsync(BrowserPrefs.PracticeBackingKey, new PracticeBacking(_tonic, _mode, _progressionId, _bpm, _click),
            PrefsJsonContext.Default.PracticeBacking);

    /// <summary>
    /// The progression that states this mode, if the catalog has one.
    /// </summary>
    /// <remarks>
    /// <see cref="ProgressionCatalog.SignatureFor"/> is the shared lookup the Mode Lab's "Match to
    /// mode" toggle uses, so the two pages cannot disagree about which cadence states a mode — and
    /// choosing one here by name would be the client making that call itself.
    /// </remarks>
    private string? SignatureIdFor(ScaleMode mode) => _progressions.SignatureFor(mode)?.Id;

    private async Task OnModePickedAsync(ScaleMode mode)
    {
        _mode = mode;
        await OnModeChangedAsync();
    }

    private async Task OnTonicPickedAsync(int tonic)
    {
        _tonic = tonic;
        await ReloadAsync();
    }

    private async Task OnProgressionPickedAsync(string id)
    {
        _progressionId = id;
        await ReloadAsync();
    }

    private async Task OnTempoPickedAsync(double bpm)
    {
        _bpm = bpm;
        await ReloadAsync();
    }

    /// <summary>A different mode brings its own signature cadence with it, matching the Mode Lab's
        /// "Chords follow mode" default — otherwise picking Phrygian would leave Dorian's chords
        /// playing. The tempo is left alone, exactly as it is there: speed is the user's to set.</summary>
    private async Task OnModeChangedAsync()
    {
        if (SignatureIdFor(_mode) is { } id)
        {
            _progressionId = id;
        }
        await ReloadAsync();
        await LoadVoiceAsync();
    }

    /// <summary>Applies the key the server chose for this mode and this voice. The page does no
    /// transposing of its own — the returned key simply replaces the one in the request.</summary>
    private async Task FitToVoiceAsync()
    {
        if (FitForMode is not { } fit || Busy)
        {
            return;
        }
        _tonic = fit.TonicPitchClass;
        await ReloadAsync();
    }

    /// <summary>
    /// The singer's range and the key that fits the current mode to it. Auxiliary to the exercise, so
    /// a failure leaves the line off the page rather than getting in the way of singing.
    /// </summary>
    private async Task LoadVoiceAsync()
    {
        try
        {
            _voice = await Analysis.GetVocalRangeAsync(_mode);
        }
        catch (HttpRequestException)
        {
            _voice = null;
        }
    }

    /// <summary>A take deleted from the list: the tally and the tab's count are read again without it,
    /// and so is the range, which is pooled from the takes.</summary>
    private async Task OnTakeDeletedAsync(string jobId)
    {
        _historyFor = null;
        await LoadHistoryAsync();
        await LoadVoiceAsync();
    }

    /// <summary>The earlier takes over the current mode and progression, fetched only when one of those
    /// changed. Like the range, a failure hides the card rather than blocking the page.</summary>
    private async Task LoadHistoryAsync()
    {
        var request = CurrentRequest();
        var key = $"{request.Mode}|{request.ProgressionId}|{request.TargetPurity}";
        if (key == _historyFor)
        {
            return;
        }
        try
        {
            _history = await Analysis.GetTakeHistoryAsync(request);
            _historyFor = key;
        }
        catch (HttpRequestException)
        {
            _history = null;
            _historyFor = null;
        }
    }

    /// <summary>A different progression in the same key and tempo. The key is deliberately left
    /// alone: a singer picks a key for their own range, not for variety.</summary>
    private async Task RerollAsync()
    {
        if (_progressions.Count > 1)
        {
            var current = _progressions.FindIndex(p => p.Id == _progressionId);
            var step = Random.Shared.Next(1, _progressions.Count);
            _progressionId = _progressions[(Math.Max(current, 0) + step) % _progressions.Count].Id;
        }
        await ReloadAsync();
    }

    /// <summary>
    /// Fetches the backing for the current settings. Any captured take is dropped with it — a take
    /// belongs to the chords it was sung over, and keeping it on screen under a different progression
    /// would offer to file it against chords nobody sang.
    /// </summary>
    private async Task ReloadAsync()
    {
        _error = null;
        await StopEverythingAsync();
        DiscardTakeState();

        var request = CurrentRequest();
        GeneratedMelodyDto? melody;
        try
        {
            melody = await Analysis.GenerateModalMelodyAsync(request);
        }
        catch (Exception ex) when (IsUnreachable(ex))
        {
            _loadError = Unreachable;
            return;
        }
        if (request != CurrentRequest())
        {
            // A slider drag fires one reload per step; only the latest may set the chords, or a
            // take could be filed against a tempo the singer never heard.
            return;
        }
        _melody = melody;
        if (_melody is null)
        {
            _loadError = "Could not load a chord progression.";
            return;
        }
        _loadError = null;
        await SaveSettingsAsync();
        await LoadHistoryAsync();
        // The generated melody is ignored on purpose. /generate returns one because the Mode Lab
        // wants it; here the melody is the singer's job, and playing the server's would be handing
        // them the answer to the question the analyzer is about to be asked.
    }

    /// <summary>The settings as the server's request shape. One copy, so the preview, the take and
    /// the upload can never describe three different progressions.</summary>
    private ModalMelodyRequest CurrentRequest()
        => new(TonicPitchClass: _tonic, Mode: _mode, ProgressionId: _progressionId, Bpm: _bpm);

    private async Task ToggleClickAsync()
    {
        _click = !_click;
        await SyncClickAsync();
        await SaveSettingsAsync();
    }

    /// <summary>The player's click to match the toggle and the tempo the chords were voiced at.</summary>
    private async Task SyncClickAsync()
    {
        if (_player is not null)
        {
            await _player.InvokeVoidAsync("setClick", _click ? _bpm : 0);
        }
    }

    // ---- Preview ----

    private async Task TogglePreviewAsync()
    {
        if (_previewing)
        {
            await StopEverythingAsync();
            return;
        }
        if (_melody is null)
        {
            return;
        }
        await EnsurePlayerAsync();
        if (_player is null)
        {
            return;
        }
        await _player.InvokeVoidAsync("setLooping", true);
        await SyncClickAsync();
        // Chords only — an empty melody list, the same call the Mode Lab makes while a take runs.
        await _player.InvokeVoidAsync(
            "play", Array.Empty<NoteEvent>(), _melody.BackingNotes, LoopSeconds, _selfRef);
        _previewing = true;
    }

    // ---- Take ----

    private async Task StartTakeAsync()
    {
        if (_melody is null || _state is not TakeState.Idle)
        {
            return;
        }
        _state = TakeState.CountingIn;
        _error = null;
        try
        {
            await EnsurePlayerAsync();
            await EnsureHumAsync();
            if (_hum is null || _player is null)
            {
                _state = TakeState.Idle;
                return;
            }

            await StopEverythingAsync();
            _backing = CurrentRequest();
            _take = null;
            _elapsedSec = 0;
            await _player.InvokeVoidAsync("setLooping", true);
            await SyncClickAsync();

            // Microphone before the clicks: the first take of a session raises the permission
            // prompt, and counting down to a dialog box helps nobody.
            if (!await _hum.InvokeAsync<bool>("beginCapture"))
            {
                _state = TakeState.Idle;
                _error = "The microphone could not be opened.";
                return;
            }

            await _hum.InvokeVoidAsync("countIn", _bpm, CountInBeats);

            _state = TakeState.Recording;
            if (_plotOn && _plot is not null)
            {
                // Chord bands now, the sung line as it arrives. The recorder pushes pitch straight
                // into the module, so nothing per-frame crosses back into here.
                await _plot.InvokeVoidAsync("prepareLive", _melody.BackingNotes, LoopSeconds, MaxTakeSeconds);
            }
            await _player.InvokeVoidAsync(
                "play", Array.Empty<NoteEvent>(), _melody.BackingNotes, LoopSeconds, _selfRef);
        }
        catch (Exception ex)
        {
            _state = TakeState.Idle;
            await CancelCaptureAsync();
            _error = ex.Message;
        }
    }

    private async Task StopTakeAsync()
    {
        if (_state is not TakeState.Recording)
        {
            return;
        }
        // Claim the transition before the first await, so a take that hits the length cap on one
        // playhead tick cannot also be stopped by the next one.
        _state = TakeState.Captured;
        _takeSec = _elapsedSec;

        try
        {
            // finishCapture reads the player's downbeat to trim the take to bar one, so it has to run
            // while the transport is still going.
            var take = _hum is null ? [] : await _hum.InvokeAsync<byte[]>("finishCapture");
            await StopEverythingAsync();

            // Empty covers both "the microphone gave us nothing" and "the take was all count-in" —
            // the recorder refuses to encode either, so neither reaches the analyzer.
            if (take.Length == 0)
            {
                _state = TakeState.Idle;
                _error = "Nothing was recorded. Try again a little louder.";
                return;
            }
            _take = take;
        }
        catch (Exception ex)
        {
            _state = TakeState.Idle;
            _error = ex.Message;
        }
    }

    private async Task ToggleReviewAsync()
    {
        if (_hum is null || _melody is null)
        {
            return;
        }
        if (_reviewing)
        {
            _reviewing = false;
            await _hum.InvokeVoidAsync("stopReview");
            return;
        }
        _reviewing = true;
        await EnsurePlayerAsync();
        await SyncClickAsync();
        // Hearing the voice alone says nothing about whether the phrase landed; the question is how
        // it sits against the harmony, so the take and the chords are scheduled from one instant.
        var seconds = await _hum.InvokeAsync<double>(
            "reviewTake", _melody.BackingNotes, LoopSeconds, _selfRef);
        if (seconds <= 0)
        {
            _reviewing = false;
        }
    }

    /// <summary>
    /// Hands the take to the analyzer and goes to the result.
    /// </summary>
    /// <remarks>
    /// The backing rides along as the request that generated it rather than as a copy of the notes,
    /// which is what lets <c>HumTakeSeeder</c> regenerate the exact progression server-side and seed
    /// it as the job's chord track. So the melody analyzed is the singer's and the harmony under it is
    /// real — and the mode the job reports is a reading of the voice, not an echo of the chords it was
    /// sung over.
    /// </remarks>
    private async Task AnalyzeTakeAsync()
    {
        if (_take is null || _backing is null || _sending)
        {
            return;
        }
        _sending = true;
        _error = null;
        try
        {
            await StopEverythingAsync();
            var job = await Analysis.UploadHumTakeAsync(_take, _backing);
            if (job is not null && !string.IsNullOrEmpty(job.JobId))
            {
                DiscardTakeState();
                NotificationService.Notify(
                    NotificationSeverity.Success, "Practice",
                    "Take saved — reading the mode of your melody.");
                Navigation.NavigateTo($"/song/{job.JobId}");
            }
            else
            {
                _error = "The analyzer would not accept the take.";
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigated away mid-send.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task DiscardTakeAsync()
    {
        await StopEverythingAsync();
        if (_hum is not null)
        {
            await _hum.InvokeVoidAsync("clearTake");
        }
        DiscardTakeState();
    }

    private void DiscardTakeState()
    {
        _state = TakeState.Idle;
        _take = null;
        _backing = null;
        _takeSec = 0;
        _elapsedSec = 0;
        _reviewing = false;
    }

    // ---- Transport plumbing ----

    private async Task StopEverythingAsync()
    {
        try
        {
            if (_reviewing && _hum is not null)
            {
                await _hum.InvokeVoidAsync("stopReview");
            }
            if (_player is not null)
            {
                await _player.InvokeVoidAsync("stop");
            }
        }
        catch (JSDisconnectedException)
        {
            // Torn down; nothing is playing either way.
        }
        _previewing = false;
        _reviewing = false;
    }

    private async Task CancelCaptureAsync()
    {
        try
        {
            if (_hum is not null)
            {
                await _hum.InvokeVoidAsync("cancelCapture");
            }
        }
        catch (JSDisconnectedException)
        {
            // Already gone.
        }
    }

    /// <summary>Every way this page starts its own chords (preview, take, review) comes through here,
    /// so it is where the jam's strumming is stopped: two loops on one clock would play over each other.</summary>
    private async Task EnsurePlayerAsync()
    {
        if (_jam is not null)
        {
            await _jam.StopAsync();
        }
        _selfRef ??= DotNetObjectReference.Create(this);
        _player ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/player/modal-player.js");
    }

    /// <summary>The jam is starting: the page's own chords stop first, whichever of them is playing.</summary>
    private async Task StopForJamAsync()
    {
        if (_previewing || _reviewing)
        {
            await StopEverythingAsync();
        }
    }

    private async Task EnsureHumAsync()
        => _hum ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/capture/hum-recorder.js");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The canvas only exists once a progression has rendered, so this cannot move into
        // OnInitializedAsync — and it must survive a reload, hence the flag.
        if (_melody is null || _plotOn)
        {
            return;
        }
        try
        {
            _plot ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/player/take-plot.js");
            var on = await _plot.InvokeAsync<bool>("init", _plotCanvas, _fluidCanvas);
            if (on != _plotOn || !_plotChecked)
            {
                _plotOn = on;
                _plotChecked = true;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigated away mid-render.
        }
    }

    /// <summary>Called from modal-player.js once per animation frame while the loop runs. The take's
    /// own length is tracked here rather than in JS so the cap lives beside the state machine.</summary>
    [JSInvokable]
    public async Task OnPlayheadUpdated(double positionSec)
    {
        _ = positionSec;
        if (_state is not TakeState.Recording || _hum is null)
        {
            return;
        }
        _elapsedSec = await _hum.InvokeAsync<double>("capturedSeconds");
        if (_elapsedSec >= MaxTakeSeconds)
        {
            await StopTakeAsync();
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPlaybackEnded()
    {
        _previewing = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnHumReviewEnded()
    {
        _reviewing = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            // Before the player, so a take still running when the page is left releases the
            // microphone — otherwise the browser's recording indicator stays lit for the session.
            if (_hum is not null)
            {
                await _hum.InvokeVoidAsync("dispose");
                await _hum.DisposeAsync();
            }
            if (_player is not null)
            {
                await _player.InvokeVoidAsync("dispose");
                await _player.DisposeAsync();
            }
            if (_plot is not null)
            {
                await _plot.InvokeVoidAsync("dispose");
                await _plot.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone during teardown.
        }
        _selfRef?.Dispose();
    }
}
