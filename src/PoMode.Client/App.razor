@implements IDisposable
@inject NavigationManager Navigation

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        @* Only after the first in-app navigation. On a fresh load nothing has focus, which is what
           lets Tab open the developer window (po-devwindow.js); after that, moving focus to the new
           page's heading is what a screen reader needs. *@
        @if (_navigated)
        {
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        }
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <NotFound />
        </LayoutView>
    </NotFound>
</Router>

@code {
    /// <summary>True once the visitor has moved to another route inside the app.</summary>
    private bool _navigated;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_navigated)
        {
            return;
        }
        _navigated = true;
        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
