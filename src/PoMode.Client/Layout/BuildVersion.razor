@* The Po build stamp: vYYMMDD, the UTC date of the commit this build came from, fixed in the
   lower-right corner by po-tokens.css (on a phone it is the last thing on the page, above the bottom
   nav). Directory.Build.props writes the date into the BuildVersion assembly metadata of every
   project; /diag shows the same. *@
<span class="po-version" aria-label="Build version">v@(Stamp)</span>

@code {
    /// <summary>YYMMDD from the BuildVersion assembly metadata (the UTC build date as a fallback).</summary>
    public static readonly string Stamp =
        typeof(BuildVersion).Assembly
            .GetCustomAttributes(typeof(System.Reflection.AssemblyMetadataAttribute), false)
            .OfType<System.Reflection.AssemblyMetadataAttribute>()
            .FirstOrDefault(a => a.Key == "BuildVersion")?.Value
        ?? DateTimeOffset.UtcNow.ToString("yyMMdd", System.Globalization.CultureInfo.InvariantCulture);
}
