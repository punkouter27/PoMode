@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject SessionState Session
@using PoMode.Shared.Account
@implements IAsyncDisposable

<a class="skip-link" href="#main-content">Skip to content</a>

@* The Po shell header (Po web standard, 2026-11-18): the name upper-left; search, optional dev-persona
   email in Development/Test, then the one settings gear upper-right, at every width. The theme
   toggle and the More menu are gone: light and dark follow the device, and the account,
   Diagnostics, the dev personas and Install moved to /settings. *@
<header class="po-header app-header">
    <a class="po-header__title" href="/">PoMode</a>
    @* One name per destination, the same at every width, in the palette and on the page. On a phone
       the bottom nav carries them, so the header keeps one row. *@
    <nav class="actions" aria-label="Main navigation">
        <SongsNavLink class="nav-link" href="">Songs</SongsNavLink>
        <NavLink class="nav-link" href="modes">Mode Lab</NavLink>
        <NavLink class="nav-link" href="practice">Practice</NavLink>
    </nav>
    <div class="po-header__actions">
        @* The palette searches every song, beat, page and setting; Ctrl+K alone left it to people who
           already knew it was there. A labelled button on a desktop, the glass alone on a phone. *@
        <button class="icon-button search-toggle" type="button" @onclick="OpenPalette" id="open-search"
                title="Search songs, pages and settings (Ctrl K)" aria-label="Search songs, pages and settings" aria-haspopup="dialog">
            <RadzenIcon Icon="search" /><span class="search-label">Search</span><kbd class="search-kbd">Ctrl K</kbd>
        </button>
        @if (Session.Current is { Kind: SessionKind.Test } signedIn)
        {
            <span class="po-header__email" id="session-email" data-session-kind="@signedIn.Kind"
                  title="@(signedIn.Email ?? signedIn.DisplayName)">@(signedIn.Email ?? signedIn.DisplayName)</span>
        }
        <a class="po-header__settings" href="/settings" id="open-settings" aria-label="Settings" title="Settings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </a>
    </div>
</header>

<CommandPalette @bind-Open="_paletteOpen" />

<MockDataBanner />
<RadzenNotification />
<RadzenDialog />

<main id="main-content" class="app-main">
    <ErrorBoundary @ref="_boundary">
        <ChildContent>
            @* Pages wait for a session: every one of them calls the API on first render, and a call
               that beats the guest cookie would land in nobody's library. *@
            @if (_sessionReady)
            {
                @Body
            }
        </ChildContent>
        <ErrorContent>
            @* Without a boundary a single component exception tears down the whole render tree
               and leaves a blank page with no way back. *@
            <div class="po-error-panel" role="alert">
                <h2>Something went wrong</h2>
                <p>This page hit an unexpected error. Try again or reload the page.</p>
                <div class="po-error-actions">
                    <RadzenButton Text="Retry" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Click="RecoverBoundary" />
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</main>

<BottomNav />
<BuildVersion />

@code {
    private IJSObjectReference? _pwa;
    private IJSObjectReference? _palette;
    private IJSObjectReference? _prefs;
    private IJSObjectReference? _push;
    private DotNetObjectReference<MainLayout>? _self;

    private bool _sessionReady;
    private bool _paletteOpen;

    private ErrorBoundary? _boundary;

    /// <summary>The layout outlives navigation, so a tripped boundary would otherwise keep showing its
    /// error panel on every page until a reload. A new page (a new Body) gets a clean start.</summary>
    protected override void OnParametersSet() => _boundary?.Recover();

    private void RecoverBoundary() => _boundary?.Recover();

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        try
        {
            await Session.EnsureAsync();
        }
        catch (HttpRequestException)
        {
            // The API is unreachable: render the pages anyway so they can show their own errors,
            // rather than a blank shell that looks like a hang.
        }
        _sessionReady = true;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Ctrl+K from anywhere (palette.js), or the header's Search button.</summary>
    [JSInvokable]
    public Task OpenPalette()
    {
        _paletteOpen = true;
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        // Before any effect module: init stamps data-fx on <html>, and every module below reads it
        // on the way up.
        _prefs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/prefs.js");
        await _prefs.InvokeVoidAsync("init");
        _self = DotNetObjectReference.Create(this);
        _palette = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/palette.js");
        await _palette.InvokeVoidAsync("listen", _self);
        await using (var layout = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/layout.js"))
        {
            await layout.InvokeVoidAsync("watchHeader");
        }
        // The install prompt fires once, on the browser's own schedule; pwa.js captures it from here,
        // on every page, so /settings can offer it whenever someone goes looking.
        _pwa = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/pwa.js");
        await _pwa.InvokeVoidAsync("watchInstall");
        await InitPushAsync();
    }

    /// <summary>After the session exists: /api/push answers signed-in callers only, and a browser
    /// that is already subscribed re-registers itself with whoever that is, on every visit. The
    /// toggle itself is on the Settings page.</summary>
    private async Task InitPushAsync()
    {
        try
        {
            await Session.EnsureAsync();
            _push = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/push.js");
            await _push.InvokeAsync<string>("init");
        }
        catch (Exception ex) when (ex is JSException or HttpRequestException)
        {
            // Nothing to re-register, which is what a browser without push support gets anyway.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnSessionChanged;
        try
        {
            if (_palette is not null)
            {
                await _palette.InvokeVoidAsync("stop");
                await _palette.DisposeAsync();
            }
            if (_pwa is not null)
            {
                await _pwa.DisposeAsync();
            }
            if (_prefs is not null)
            {
                await _prefs.DisposeAsync();
            }
            if (_push is not null)
            {
                await _push.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone during teardown.
        }
        // After the JS side has stopped calling in, so a transition in flight cannot invoke a
        // disposed reference.
        _self?.Dispose();
    }
}
