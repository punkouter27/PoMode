<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:PoMode.Mobile.Pages"
       x:Class="PoMode.Mobile.AppShell"
       Title="PoMode">

    <TabBar>
        <ShellContent Title="Songs" Route="songs" ContentTemplate="{DataTemplate pages:LibraryPage}" />
        <ShellContent Title="Practice" Route="practice" ContentTemplate="{DataTemplate pages:PracticePage}" />
        <ShellContent Title="Mode Lab" Route="modes" ContentTemplate="{DataTemplate pages:ModeLabPage}" />
        <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>

</Shell>
