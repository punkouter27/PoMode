<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:PoMode.Mobile.Pages"
       x:Class="PoMode.Mobile.AppShell"
       Title="PoMode">

    <TabBar>
        <ShellContent Title="Studio" Route="studio" ContentTemplate="{DataTemplate pages:CaptureStudioPage}" />
        <ShellContent Title="Library" Route="library" ContentTemplate="{DataTemplate pages:LibraryPage}" />
        <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>

</Shell>
